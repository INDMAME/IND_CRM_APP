{
  "name": "ind_crm_app",
  "version": "1.0.0",
  "description": "",
  "main": "tailwind.config.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "playwright test",
    "test:e2e:dev": "set IND_E2E_DEVTOOLS=true&& playwright test",
    "test:e2e:auth:capture": "set IND_E2E_USE_AUTH_STATE=false&& playwright test tests/auth-capture.spec.js --headed --workers=1",
    "test:e2e:auth:capture:dev": "set IND_E2E_DEVTOOLS=true&& set IND_E2E_USE_AUTH_STATE=false&& playwright test tests/auth-capture.spec.js --headed --workers=1",
    "test:e2e:auth:clear": "node -e \"require('node:fs').rmSync('tests/.auth', { recursive: true, force: true })\"",
    "build:css": "tailwindcss -c tailwind.config.js -i ./Web/wwwroot/css/input.css -o ./Web/wwwroot/css/tailwind.css --minify",
    "build:react": "node scripts/build-react.mjs",
    "build:react:prod": "node scripts/build-react.mjs --prod",
    "build": "npm run build:react && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INDMAME/IND_CRM_APP.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/INDMAME/IND_CRM_APP/issues"
  },
  "homepage": "https://github.com/INDMAME/IND_CRM_APP#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
