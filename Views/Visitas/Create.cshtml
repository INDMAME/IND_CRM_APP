@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear Visita";
    ViewData["BodyClass"] = "visitas-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/visitas.css" />
}

<div class="visita-page w-full max-w-3xl mx-auto pb-8 px-4 md:px-6 mt-4 md:mt-6 min-h-screen" style="overflow: visible;">
    <div id="visitas-app-root"></div>
</div>

@section Scripts {
    <script>
        window.__VISIT_TYPES__ = @Html.Raw(JsonSerializer.Serialize(ViewBag.CRMTipoVisitaEnum ?? new object[] { }));
        window.__ASISTENTE_TIPOS__ = @Html.Raw(JsonSerializer.Serialize(ViewBag.AsistenteTipoEnum ?? new object[] { }));
        window.__AX_USER__ = "@((ViewBag.AxUser ?? "").ToString())";
    </script>
    <script src="~/js/create.js" asp-append-version="true"></script>
}
