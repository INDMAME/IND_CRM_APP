@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear visita CRM";
}

<div class="container py-4">

    <!-- Encabezado -->
    <div class="text-center mb-4">
        <h3 class="fw-bold text-primary mb-2">
            <i class="bi bi-people-fill me-2"></i> Crear visita CRM
        </h3>
        <p class="text-muted small">
            Datos desde Axapta 3.0 —
            <strong>Ambiente:</strong> @Html.Raw(ViewBag.Environment ?? "Desconocido")
            <span class="mx-2">|</span>
            <strong>Compañía:</strong> @Html.Raw(ViewBag.Company ?? "N/A")
        </p>
    </div>

    <!-- Indicadores de pasos -->
    <div class="row mb-4">
        <div class="col-md-6 mb-2">
            <div id="step1Indicator" class="card border-primary">
                <div class="card-body py-2">
                    <strong>Paso 1:</strong> Seleccionar cliente y contacto
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-2">
            <div id="step2Indicator" class="card border-light">
                <div class="card-body py-2">
                    <strong>Paso 2:</strong> Detalles de la visita
                </div>
            </div>
        </div>
    </div>

    <!-- Paso 1 -->
    <div id="step1Container">
        <div class="row g-4">

            <!-- CLIENTE -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-semibold">
                        1. Selecciona un cliente
                    </div>
                    <div class="card-body position-relative">

                        <div id="clientSearchContainer" class="position-relative mb-3">
                            <label class="form-label small text-muted">Buscar cliente</label>
                            <div class="input-group">
                                <input id="clientSearchInput"
                                       type="text"
                                       class="form-control"
                                       placeholder="Escribe al menos 4 caracteres..." />
                                <button id="clientToggleButton"
                                        class="btn btn-outline-primary"
                                        type="button">
                                    <i id="clientToggleIcon" class="bi bi-caret-down-fill"></i>
                                </button>
                            </div>

                            <div id="clientInnerSpinner" class="mt-2 small text-muted" style="display:none;">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Buscando clientes...</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span id="clientCounter" class="badge bg-secondary">0 clientes</span>
                                <span id="clientStatus" class="small text-muted"></span>
                            </div>

                            <ul id="clientList"
                                class="list-group shadow-sm position-absolute"
                                style="max-height: 350px; overflow-y: auto; width: 100%; display:none; z-index:1000; margin-top:4px;">
                            </ul>

                            <div class="mt-2 text-end">
                                <button id="clientLoadMoreBtn"
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        style="display:none;">
                                    Cargar más
                                </button>
                            </div>
                        </div>

                        <!-- Cliente seleccionado -->
                        <div id="selectedClientCard"
                             class="card border-primary mt-3"
                             style="display:none;">
                            <div class="card-body py-2">
                                <div id="selectedClientMain" class="fw-semibold text-primary"></div>
                                <div id="selectedClientSecondary" class="text-muted small"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- CONTACTO -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-semibold">
                        2. Selecciona contacto
                    </div>
                    <div class="card-body position-relative">

                        <div id="contactSearchContainer" class="position-relative mb-3">
                            <label class="form-label small text-muted">Buscar contacto</label>
                            <div class="input-group">
                                <input id="contactSearchInput"
                                       type="text"
                                       class="form-control"
                                       placeholder="Filtrar por nombre, cargo o empresa..."
                                       disabled />
                                <button id="contactToggleButton"
                                        class="btn btn-outline-primary"
                                        type="button"
                                        disabled>
                                    <i id="contactToggleIcon" class="bi bi-caret-down-fill"></i>
                                </button>
                            </div>

                            <div id="contactInnerSpinner" class="mt-2 small text-muted" style="display:none;">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Cargando contactos...</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span id="contactCounter" class="badge bg-secondary">0 contactos</span>
                                <span id="contactStatus" class="small text-muted"></span>
                            </div>

                            <ul id="contactList"
                                class="list-group shadow-sm position-absolute"
                                style="max-height: 350px; overflow-y: auto; width: 100%; display:none; z-index:1000; margin-top:4px;">
                            </ul>
                        </div>

                        <!-- Contacto seleccionado -->
                        <div id="selectedContactCard"
                             class="card border-primary mt-3"
                             style="display:none;">
                            <div class="card-body py-2">
                                <div id="selectedContactMain" class="fw-semibold text-primary"></div>
                                <div id="selectedContactSecondary" class="text-muted small"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Botón continuar -->
        <div class="text-end mt-4">
            <button id="btnGoStep2"
                    class="btn btn-primary"
                    type="button"
                    disabled>
                Continuar al paso 2
            </button>
        </div>
    </div>

    <!-- Paso 2 -->
    <div id="step2Container" style="display:none;">
        <div class="row g-4">

            <!-- Resumen -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-semibold">
                        Resumen
                    </div>
                    <div class="card-body">
                        <p class="small mb-1 text-muted">Cliente</p>
                        <p id="summaryClient" class="fw-semibold"></p>

                        <p class="small mb-1 text-muted mt-3">Contacto</p>
                        <p id="summaryContact" class="fw-semibold"></p>
                    </div>
                </div>
            </div>

            <!-- Datos de actividad -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-semibold">
                        Datos de la visita
                    </div>
                    <div class="card-body">

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Tipo de visita</label>
                                <select id="visitType" class="form-select">
                                    @foreach (var item in ViewBag.CRMTipoVisitaEnum)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            
                            <div class="col-md-4">
                                <label class="form-label">Usuario</label>
                                <input id="userId"
                                       class="form-control"
                                       value="@((ViewBag.AxUser ?? "").ToString())"
                                       readonly style="background-color:#e9ecef;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha</label>
                                <input id="transDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo asistente</label>
                                <select id="asistenteTipo" class="form-select">
                                    @foreach (var item in ViewBag.AsistenteTipoEnum)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <input id="description"
                                       class="form-control"
                                       maxlength="200" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Comentarios</label>
                                <textarea id="comentarios" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Antecedentes</label>
                                <textarea id="antecedentes" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Conclusiones</label>
                                <textarea id="conclusiones" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div id="activityStatus" class="mt-3"></div>

                        <div class="d-flex justify-content-between mt-3">
                            <button id="btnBackToStep1"
                                    type="button"
                                    class="btn btn-outline-secondary">
                                Volver al paso 1
                            </button>

                            <button id="btnSubmitActivity"
                                    type="button"
                                    class="btn btn-success">
                                Crear visita
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/visitas.client.js?ver=@DateTime.Now.Ticks" "></script> 
}
