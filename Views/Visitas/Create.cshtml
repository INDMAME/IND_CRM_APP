@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear Visita";
}

@section Styles {
    <link rel="stylesheet" href="~/css/visitas.css" />
    <link rel="stylesheet" href="~/css/technical-info.css" />
}

<div class="container visita-page pb-4" style="max-width: 1100px;">

    <!-- Subtítulo técnico -->
    <p class="tech-info mb-2 mt-1">
        Datos desde Axapta 3.0 —
        <strong>Ambiente:</strong> @Html.Raw(ViewBag.Environment ?? "Desconocido")
        <span class="mx-2">|</span>
        <strong>Compañía:</strong> @Html.Raw(ViewBag.Company ?? "N/A")
    </p>

    <!-- PASO 1 -->
    <div id="step1Container">
        <div class="row g-4">

            <!-- CLIENTE -->
            <div class="col-md-6">
                <div class="card visita-card shadow-sm">
                    <div class="card-header visita-card-header">
                        Selecciona un cliente
                    </div>
                    <div class="card-body visita-card-body position-relative">

                        <div id="clientSearchContainer" class="position-relative mb-3">

                            <label class="form-label small text-muted">Buscar cliente</label>

                            <div class="input-group">
                                <input id="clientSearchInput"
                                       type="text"
                                       class="form-control"
                                       placeholder="Escribe al menos 4 caracteres..." />

                                <button id="clientToggleButton"
                                        class="btn btn-outline-primary"
                                        type="button">
                                    <i id="clientToggleIcon" class="bi bi-caret-down-fill"></i>
                                </button>
                            </div>

                            <div id="clientInnerSpinner" class="mt-2 small text-muted" style="display:none;">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Buscando clientes...</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span id="clientCounter" class="tech-badge">0 clientes</span>
                                <span id="clientStatus" class="small text-muted"></span>
                            </div>

                            <ul id="clientList"
                                class="list-group shadow-sm position-absolute"
                                style="max-height: 350px; overflow-y: auto; width: 100%; display:none; z-index:1000;">
                            </ul>

                            <div class="mt-2 text-end">
                                <button id="clientLoadMoreBtn"
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        style="display:none;">
                                    Cargar más
                                </button>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <!-- CONTACTO -->
            <div class="col-md-6">
                <div class="card visita-card shadow-sm">
                    <div class="card-header visita-card-header">
                        Selecciona contacto
                    </div>
                    <div class="card-body visita-card-body position-relative">

                        <div id="contactSearchContainer" class="position-relative mb-3">
                            <label class="form-label small text-muted">Buscar contacto</label>

                            <div class="input-group">
                                <input id="contactSearchInput"
                                       type="text"
                                       class="form-control"
                                       placeholder="Filtrar por nombre, cargo o empresa..."
                                       disabled />

                                <button id="contactToggleButton"
                                        class="btn btn-outline-primary"
                                        type="button"
                                        disabled>
                                    <i id="contactToggleIcon" class="bi bi-caret-down-fill"></i>
                                </button>
                            </div>

                            <div id="contactInnerSpinner" class="mt-2 small text-muted" style="display:none;">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Cargando contactos...</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span id="contactCounter" class="tech-badge">0 contactos</span>
                                <span id="contactStatus" class="small text-muted"></span>
                            </div>

                            <ul id="contactList"
                                class="list-group shadow-sm position-absolute"
                                style="max-height: 350px; overflow-y: auto; width: 100%; display:none; z-index:1000;">
                            </ul>
                        </div>

                        <!-- Contacto seleccionado -->
                        <div id="selectedContactCard"
                             class="card border-primary mt-3"
                             style="display:none;">
                            <div class="card-body py-2">
                                <div id="selectedContactMain" class="fw-semibold text-primary"></div>
                                <div id="selectedContactSecondary" class="text-muted small"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Navegación manejada desde la topbar -->
    </div>


    <!-- ============================================
         PASO 2 – Detalles de la visita
    ============================================= -->
    <div id="step2Container" style="display:none;" class="mt-5">

        <div class="card visita-card shadow-sm">
            <div class="card-header visita-card-header">
                Datos de la visita
            </div>

            <div class="card-body visita-card-body">

                <input type="hidden" id="userId" value="@((ViewBag.AxUser ?? "").ToString())" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Fecha</label>
                        <input id="transDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tipo de visita</label>
                        <select id="visitType" class="form-select">
                            @foreach (var item in ViewBag.CRMTipoVisitaEnum)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tipo asistente</label>
                        <select id="asistenteTipo" class="form-select">
                            @foreach (var item in ViewBag.AsistenteTipoEnum)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <input id="description" class="form-control" maxlength="200" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Comentarios</label>
                        <textarea id="comentarios" class="form-control"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Antecedentes</label>
                        <textarea id="antecedentes" class="form-control"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Conclusiones</label>
                        <textarea id="conclusiones" class="form-control"></textarea>
                    </div>

                </div>

                <div id="activityStatus" class="mt-3"></div>

            </div>
        </div>

        <!-- Acción principal -->
        <button id="btnSubmitActivity" class="btn btn-primary mt-4">
            <i class="bi bi-check2-circle me-1"></i> Crear visita
        </button>

    </div>

</div>

@section Scripts {
    <script src="~/js/visitas.client.js?ver=@DateTime.Now.Ticks"></script>
}
