@inject Microsoft.AspNetCore.Http.IHttpContextAccessor? HttpAccessor
@using IND_CRM_APP.Infrastructure.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

@{
#pragma warning disable CS8602
#pragma warning disable CS8600
    ViewData["Title"] = SR["Visits_History_Title"];
    ViewData["HideNavArrows"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/historial.css" asp-append-version="true" />
}

<div class="max-w-3xl mx-auto px-1 sm:px-2 pt-2 pb-3 space-y-2">

    <!-- Compact date selector -->
    <div class="timeline-card filter-card glass-panel shadow-card p-3 sm:p-4 relative">
        <div id="drpActivator" class="drp w-full">
            <div class="drp-section" data-section="start">
                <div class="drp-label">@SR["History_From"].Value.ToUpperInvariant()</div>
                <div class="drp-value">
                    <i class="bi bi-calendar3 drp-icon"></i>
                    <span id="drpStartValue">@SR["History_AddDate"]</span>
                </div>
            </div>

            <div class="drp-separator hidden sm:flex">
                <i class="bi bi-arrow-right"></i>
            </div>
            <div class="drp-separator-mobile flex sm:hidden"></div>

            <div class="drp-section" data-section="end">
                <div class="drp-label">@SR["History_To"].Value.ToUpperInvariant()</div>
                <div class="drp-value">
                    <i class="bi bi-calendar3 drp-icon"></i>
                    <span id="drpEndValue">@SR["History_AddDate"]</span>
                </div>
            </div>

            <button type="button" id="drpClear" class="drp-clear" aria-label="@SR["History_ClearRange"]" style="display:none;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div id="drpPopover" class="drp-popover" hidden>
            <div class="drp-head">
                <button type="button" class="drp-nav" data-dir="prev" aria-label="@SR["History_PrevMonth"]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 30 30" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <div id="drpMonthLabel" class="drp-month"></div>
                <button type="button" class="drp-nav" data-dir="next" aria-label="@SR["History_NextMonth"]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 30 30" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
            <div class="drp-weekdays">
                <span>@SR["History_Day_Mon"]</span><span>@SR["History_Day_Tue"]</span><span>@SR["History_Day_Wed"]</span><span>@SR["History_Day_Thu"]</span><span>@SR["History_Day_Fri"]</span><span>@SR["History_Day_Sat"]</span><span>@SR["History_Day_Sun"]</span>
            </div>
            <div id="drpGrid" class="drp-grid"></div>
            <div id="drpStatus" class="drp-status">@SR["History_Status_SelectStart"]</div>
        </div>
    </div>

    <input type="hidden" id="fromDate" value="@ViewBag.DefaultFromDate" />
    <input type="hidden" id="toDate" value="@ViewBag.DefaultToDate" />
    <!-- Loader -->
    <div id="resultsLoader" class="loader-box glass-panel shadow-card flex items-center gap-2 text-sm text-slate-700" style="display:none;">
        <svg class="ind-spinner h-5 w-5" viewBox="0 0 20 20" role="status" aria-label="@SR["Common_Loading"]">
            <circle class="ind-spinner__circle" cx="10" cy="10" r="8" stroke-width="2"></circle>
        </svg>
        @SR["History_Loading"]
    </div>

    <!-- Timeline -->
    <div id="timelineContainer" class="timeline-box"></div>

    <!-- Pagination -->
    <ul id="pagination" class="pagination"></ul>
</div>

@section Scripts {
    <script>
        window.__IND_I18N__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            History_AddDate = SR["History_AddDate"].Value,
            History_Status_SelectStart = SR["History_Status_SelectStart"].Value,
            History_Status_SelectEnd = SR["History_Status_SelectEnd"].Value,
            History_Loading = SR["History_Loading"].Value,
            History_NoDataInRange = SR["History_NoDataInRange"].Value,
            Common_NoData = SR["Common_NoData"].Value,
            Api_RequestFailed = SR["Api_RequestFailed"].Value,
            Api_InvalidJson = SR["Api_InvalidJson"].Value
        }));
    </script>
    <script src="~/js/history.js" asp-append-version="true"></script>
}
