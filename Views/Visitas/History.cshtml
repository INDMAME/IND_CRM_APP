@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpAccessor

@{
    ViewData["Title"] = "Historial de actividades";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Historial.css" />
}

<div class="historial-container">

    <div class="crm-filter-box">
        <h3 class="crm-filter-title">Historial de Actividades</h3>

        <div class="row">
            <div class="col-md-4">
                <label class="crm-label">Desde</label>
                <input type="date" id="fromDate" class="form-control"
                       value="@ViewBag.DefaultFromDate" />
            </div>

            <div class="col-md-4">
                <label class="crm-label">Hasta</label>
                <input type="date" id="toDate" class="form-control"
                       value="@ViewBag.DefaultToDate" />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button id="btnSearch" class="btn crm-btn w-100">
                    Buscar
                </button>
            </div>
        </div>

        <!-- Usuario -->
        <div class="mt-3">
            <label class="crm-label">Usuario</label>
            <input type="text" class="form-control"
                   value="@HttpAccessor.HttpContext.Session.GetString("AxUser")" disabled />
        </div>
    </div>

    <!-- Loader -->
    <div id="resultsLoader" class="loader-box" style="display:none;">
        <div class="spinner-border text-primary"></div> Cargando datos...
    </div>

    <!-- Timeline -->
    <div id="timelineContainer" class="timeline-box"></div>

    <!-- Paginación -->
    <ul id="pagination" class="pagination"></ul>
</div>

<script src="~/js/history.js?cache=@DateTime.Now.Ticks"></script>

<script>
    window.CurrentAxUser = "@(HttpAccessor.HttpContext.Session.GetString("AxUser"))";
</script>
