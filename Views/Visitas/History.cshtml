@inject Microsoft.AspNetCore.Http.IHttpContextAccessor? HttpAccessor

@{
#pragma warning disable CS8602
#pragma warning disable CS8600
    ViewData["Title"] = "Historial";
    ViewData["HideNavArrows"] = true;
    var userHiddenValue = HttpAccessor?.HttpContext?.Session?.GetString("AxUser") ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/historial.css" asp-append-version="true" />
}

<div class="max-w-3xl mx-auto px-1 sm:px-2 py-4 space-y-4">

    <!-- Selector de fechas compactado -->
    <div class="timeline-card filter-card glass-panel shadow-card p-3 sm:p-4 relative">
        <div id="drpActivator" class="drp w-full">
            <div class="drp-section" data-section="start">
                <div class="drp-label">DESDE</div>
                <div class="drp-value">
                    <i class="bi bi-calendar3 drp-icon"></i>
                    <span id="drpStartValue">Anadir fecha</span>
                </div>
            </div>

            <div class="drp-separator hidden sm:flex">
                <i class="bi bi-arrow-right"></i>
            </div>
            <div class="drp-separator-mobile flex sm:hidden"></div>

            <div class="drp-section" data-section="end">
                <div class="drp-label">HASTA</div>
                <div class="drp-value">
                    <i class="bi bi-calendar3 drp-icon"></i>
                    <span id="drpEndValue">Anadir fecha</span>
                </div>
            </div>

            <button type="button" id="drpClear" class="drp-clear" aria-label="Limpiar rango" style="display:none;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div id="drpPopover" class="drp-popover" hidden>
            <div class="drp-head">
                <button type="button" class="drp-nav" data-dir="prev" aria-label="Mes anterior">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <div id="drpMonthLabel" class="drp-month"></div>
                <button type="button" class="drp-nav" data-dir="next" aria-label="Mes siguiente">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
            <div class="drp-weekdays">
                <span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span>
            </div>
            <div id="drpGrid" class="drp-grid"></div>
            <div id="drpStatus" class="drp-status">Selecciona la fecha de llegada</div>
        </div>
    </div>

    <input type="hidden" id="fromDate" value="@ViewBag.DefaultFromDate" />
    <input type="hidden" id="toDate" value="@ViewBag.DefaultToDate" />
    <input type="hidden" id="userHidden" value="@userHiddenValue" />

    <!-- Loader -->
    <div id="resultsLoader" class="loader-box glass-panel shadow-card" style="display:none;">
        <div class="spinner-border text-primary"></div> Cargando datos...
    </div>

    <!-- Timeline -->
    <div id="timelineContainer" class="timeline-box"></div>

    <!-- Paginación -->
    <ul id="pagination" class="pagination"></ul>
</div>

@section Scripts {
    <script>
        window.CurrentAxUser = "@(HttpAccessor?.HttpContext.Session.GetString("AxUser"))";
    </script>
    <script src="~/js/history.js" asp-append-version="true"></script>
}
