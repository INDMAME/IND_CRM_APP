@model IND_CRM_APP.Models.Shared.LoginRequest
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/tailwind.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="min-h-screen bg-[#00296b] text-slate-100 font-sans">
    <div class="absolute inset-0 bg-[#00296b]"></div>

    <div class="relative flex min-h-screen items-center justify-center px-4">
        <div class="w-full max-w-sm">

            <div class="bg-white border border-slate-100 rounded-2xl shadow-2xl px-6 py-8">
                <div class="flex flex-col items-center gap-3 mb-6">
                    <img src="~/images/insertec_sin_fondo.png" alt="Insertec" class="drop-shadow-lg" style="height: 96px;" />
                </div>

                <div class="mb-2 text-center">
                    <h1 class="text-xl font-semibold text-slate-900">Bienvenido</h1>
                    <p class="text-sm text-slate-600">Ingresa tus credenciales para continuar</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-red-700 text-sm rounded-xl px-3 py-2 mb-3 border border-red-100">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post" class="space-y-3">

                    <div class="space-y-1">
                        <label for="inputUser" class="sr-only">Usuario</label>
                        <input asp-for="Username"
                               id="inputUser"
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[--color-primary] focus:border-[--color-primary] placeholder:text-slate-400"
                               placeholder="Usuario" />
                        <span asp-validation-for="Username" class="text-sm text-red-100"></span>
                    </div>

                    <div class="space-y-1">
                        <label for="inputPassword" class="sr-only">Contrasena</label>
                        <div class="relative">
                            <input asp-for="Password"
                                   id="inputPassword"
                                   type="password"
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 pr-12 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[--color-primary] focus:border-[--color-primary] placeholder:text-slate-400"
                                   placeholder="Contrasena" />
                            <button type="button"
                                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-500 hover:text-slate-700"
                                    onclick="togglePassword()"
                                    aria-label="Mostrar u ocultar contrasena">
                                👁
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-sm text-red-100"></span>
                    </div>

                    <div class="flex items-center justify-end text-sm text-slate-700">
                        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                            <input id="rememberMe" type="checkbox" class="rounded border-slate-300 text-[--color-primary] focus:ring-[--color-primary] bg-white" />
                            <span>Recordarme</span>
                        </label>
                    </div>

                    <button type="submit" class="w-full rounded-xl border border-transparent bg-[--color-primary] text-white font-semibold px-4 py-2 shadow-md hover:bg-[#001f4d] transition">
                        Iniciar sesion
                    </button>
                </form>

            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById("inputPassword");
            if (!input) return;
            input.type = input.type === "password" ? "text" : "password";
        }

        // Remember me: store username in localStorage
        (function rememberMe() {
            const userInput = document.getElementById("inputUser");
            const rememberCheckbox = document.getElementById("rememberMe");
            if (!userInput || !rememberCheckbox) return;

            const stored = localStorage.getItem("crmRememberUser");
            if (stored) {
                userInput.value = stored;
                rememberCheckbox.checked = true;
            }

            rememberCheckbox.addEventListener("change", () => {
                if (rememberCheckbox.checked) {
                    localStorage.setItem("crmRememberUser", userInput.value || "");
                } else {
                    localStorage.removeItem("crmRememberUser");
                }
            });

            userInput.addEventListener("input", () => {
                if (rememberCheckbox.checked) {
                    localStorage.setItem("crmRememberUser", userInput.value || "");
                }
            });
        })();
    </script>

</body>
</html>
