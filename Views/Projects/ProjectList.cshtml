@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*
    ╔═══════════════════════════════════════════════════════════════════╗
    ║ VISTA: LISTADO DE PROYECTOS                                       ║
    ║-------------------------------------------------------------------║
    ║ - Interfaz principal para consultar proyectos en Axapta.           ║
    ║ - Busca por ID, Nombre o Cliente.                                 ║
    ║ - Implementa caché en sessionStorage.                             ║
    ║ - Incluye tarjeta informativa al seleccionar un proyecto.         ║
    ║ - La búsqueda se ejecuta solo con Enter o clic en la flecha.      ║
    ║ - Usa un spinner interno para feedback visual.                    ║
    ╚═══════════════════════════════════════════════════════════════════╝
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listado de Proyectos";
}

<div class="container py-5">
    <!-- Encabezado -->
    <div class="text-center mb-4">
        <h3 class="fw-bold text-primary mb-2">
            <i class="bi bi-kanban-fill me-2"></i>Listado de Proyectos
        </h3>
        <p class="text-muted small">
            Datos obtenidos de Axapta 3.0 —
            <strong>Ambiente:</strong> @Html.Raw(ViewBag.Environment ?? "Desconocido")
            <span class="mx-2">|</span>
            <strong>Compañía:</strong> @Html.Raw(ViewBag.Company ?? "N/A")
        </p>
    </div>

    <!-- Contador -->
    <div class="text-center mb-3">
        <span id="projectCounter" class="badge bg-secondary fs-6 me-2">0 proyectos</span>
        <span id="loadTime" class="text-muted small">Tiempo de carga: —</span>
    </div>

    <!-- Búsqueda -->
    <div id="searchContainer" class="position-relative mx-auto" style="max-width:400px;">
        <div class="input-group mb-3">
            <input id="searchInput" type="text" class="form-control shadow-sm"
                   placeholder="Buscar por ID, nombre o cliente...">
            <button id="toggleButton" class="btn btn-outline-primary" type="button">
                <i id="toggleIcon" class="bi bi-caret-down-fill"></i>
            </button>
        </div>

        <!-- Lista de resultados -->
        <ul id="projectList" class="list-group shadow-sm position-absolute"
            style="max-height: 450px; overflow-y: auto; width: 100%; display:none; z-index:1000;"></ul>
    </div>

    <!-- Tarjeta de detalle del proyecto seleccionado -->
    <div id="selectedProjectCard" class="card shadow-sm mt-4 mx-auto fade-in"
         style="max-width:400px; display:none;">
        <div class="card-body">
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-kanban"></i> Proyecto Seleccionado
            </h5>
            <p class="mb-1"><strong>ID:</strong> <span id="projId" class="text-muted"></span></p>
            <p class="mb-1"><strong>Nombre:</strong> <span id="projName" class="text-muted"></span></p>
            <p class="mb-0"><strong>Cliente:</strong> <span id="projClient" class="text-muted"></span></p>
        </div>
    </div>


    <!-- Loader -->
    <div id="mainSpinner" class="text-center py-3" style="display:none;">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted small mt-2">Cargando proyectos...</p>
    </div>

    <!-- Indicadores -->
    <div id="statusContainer" class="text-center mt-3"></div>

    <!-- Botón limpiar caché -->
    <div class="text-center mt-2">
        <button id="clearCacheBtn" class="btn btn-sm btn-outline-secondary">
            🗑️ Vaciar caché
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const list = document.getElementById("projectList");
            const search = document.getElementById("searchInput");
            const toggleBtn = document.getElementById("toggleButton");
            const toggleIcon = document.getElementById("toggleIcon");
            const counter = document.getElementById("projectCounter");
            const loadTime = document.getElementById("loadTime");
            const loading = document.getElementById("mainSpinner");
            const statusContainer = document.getElementById("statusContainer");
            const clearCacheBtn = document.getElementById("clearCacheBtn");

            // 🧾 Tarjeta del proyecto seleccionado
            const card = document.getElementById("selectedProjectCard");
            const projId = document.getElementById("projId");
            const projName = document.getElementById("projName");
            const projClient = document.getElementById("projClient");

            // 🌀 Spinner interno (un solo elemento centralizado)
            const spinnerContainer = document.createElement("div");
            spinnerContainer.id = "innerSpinner";
            spinnerContainer.className = "position-absolute top-50 start-50 translate-middle text-center";
            spinnerContainer.style.cssText = `
                display: none;
                z-index: 1100;
            `;

            spinnerContainer.innerHTML = `
                <div class="spinner-border text-primary" style="width:2.2rem;height:2.2rem;" role="status"></div>
                <p class="text-muted small mt-2 mb-0">Buscando proyectos...</p>
            `;

                    // 🔹 Se agrega dentro del contenedor principal, no fuera
        document.getElementById("searchContainer").appendChild(spinnerContainer);


            // ✨ Animaciones
            const fadeStyle = document.createElement("style");
            fadeStyle.innerHTML = `
                .fade-in { opacity: 0; transition: opacity 0.3s ease-in; }
                .fade-in.show { opacity: 1; }
            `;
            document.head.appendChild(fadeStyle);

            const CACHE_KEY = "projectCache";
            let cache = new Map(JSON.parse(sessionStorage.getItem(CACHE_KEY) || "[]"));
            let lastFilter = "";
            let listVisible = false;

            function setStatus(text, color) {
                statusContainer.innerHTML = `<span class="${color} small">${text}</span>`;
            }

            function capitalize(text) {
                if (!text) return "";
                return text
                    .toLowerCase()
                    .split(' ')
                    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
                    .join(' ');
            }

            function saveCache() {
                const arr = Array.from(cache.entries());
                sessionStorage.setItem(CACHE_KEY, JSON.stringify(arr));
                if (arr.length > 20) {
                    cache.clear();
                    sessionStorage.removeItem(CACHE_KEY);
                }
            }

            function renderProjects(items, total, reset) {
                if (reset) list.innerHTML = "";
                spinnerContainer.style.display = "none";

                if (!items?.length) {
                    setStatus("No se encontraron proyectos.", "text-muted");
                    list.style.display = "none";
                    return;
                }

                counter.textContent = `${total || items.length} proyectos`;
                list.classList.add("fade-in");
                list.classList.remove("show");

                setTimeout(() => {
                    for (const p of items) {
                        const li = document.createElement("li");
                        li.className = "list-group-item list-group-item-action";
                        li.innerHTML = `
                            <div class="fw-semibold text-primary">${p.id.toUpperCase()} — ${capitalize(p.name)}</div>
                            <div class="text-muted small">${capitalize(p.client) || "(Sin cliente)"}</div>
                        `;

                        // 🖱️ Al seleccionar un proyecto → actualiza tarjeta
                        li.addEventListener("click", () => {
                            updateProjectCard(p);
                            hideList();
                        });

                        list.appendChild(li);
                    }
                    list.style.display = "block";
                    requestAnimationFrame(() => list.classList.add("show"));
                }, 50);
            }

            async function fetchProjects(filter, reset = false, force = false) {
                const key = filter.toLowerCase();
                const cached = cache.get(key);

                list.innerHTML = "";
                spinnerContainer.style.display = "block";
                list.style.display = "block";

                if (cached && !force) {
                    renderProjects(cached, cached.length, true);
                    counter.textContent = `${cached.length} proyectos`;
                    loadTime.textContent = "Tiempo de carga: 0.00s";
                    setStatus("📦 Resultados desde caché", "text-success");
                    list.style.backgroundColor = "#f8f9fa";
                    return;
                }

                // 🌐 Consulta servidor
                loading.style.display = "block";
                setStatus("🌐 Consultando servidor...", "text-primary");
                list.style.backgroundColor = "#e8f3ff";

                const t0 = performance.now();
                const res = await fetch(`/ProjectList/GetProjects?filter=${encodeURIComponent(filter)}&skip=0&take=200`);
                const data = await res.json();
                const duration = ((performance.now() - t0) / 1000).toFixed(2);
                loading.style.display = "none";

                const items = data.items ?? [];
                cache.set(key, items);
                saveCache();

                renderProjects(items, data.total ?? 0, reset);
                counter.textContent = `${data.total || items.length} proyectos`;
                loadTime.textContent = `Tiempo de carga: ${duration}s`;
                setStatus("🟢 Datos en vivo desde servidor", "text-primary");
            }

            function startSearch(force = false) {
                const filter = search.value.trim();

                if (filter.length < 4) {
                    list.innerHTML = "";
                    list.style.display = "none";
                    spinnerContainer.style.display = "none";
                    counter.textContent = "0 proyectos";
                    setStatus("⌨️ Escribe al menos 4 caracteres para buscar.", "text-warning");
                    lastFilter = "";
                    return;
                }

                if (filter === lastFilter && !force) return;

                lastFilter = filter;
                list.innerHTML = "";
                counter.textContent = "0 proyectos";
                fetchProjects(filter, true, force);
            }

            function updateProjectCard(p) {
                projId.textContent = p.id.toUpperCase();
                projName.textContent = capitalize(p.name);
                projClient.textContent = capitalize(p.client) || "(Sin cliente)";
                card.style.display = "block";

                // 💫 Animación al mostrar / actualizar
                card.classList.remove("show");
                requestAnimationFrame(() => card.classList.add("show"));
            }

            // ⏎ Enter → buscar y abrir lista
            search.addEventListener("keypress", e => {
                if (e.key === "Enter") {
                    startSearch(true);
                    showList();
                }
            });

            // 🔽 Flecha → abrir/cerrar lista
            toggleBtn.addEventListener("click", () => {
                if (listVisible) hideList();
                else {
                    startSearch(true);
                    showList();
                }
            });

            function showList() {
                listVisible = true;
                list.style.display = "block";
                toggleIcon.className = "bi bi-caret-up-fill";
            }

            function hideList() {
                listVisible = false;
                list.style.display = "none";
                toggleIcon.className = "bi bi-caret-down-fill";
            }

            // 🧹 Limpiar caché
            clearCacheBtn.addEventListener("click", () => {
                cache.clear();
                sessionStorage.removeItem(CACHE_KEY);
                setStatus("🗑️ Caché vaciada.", "text-muted");
            });

            // 🖱️ Cerrar lista al hacer clic fuera
            document.addEventListener("click", e => {
                const clickedInside = e.target.closest("#searchContainer");
                if (!clickedInside && listVisible) hideList();
            });
        });
    </script>
}
