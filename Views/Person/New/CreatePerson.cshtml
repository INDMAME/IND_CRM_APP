@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear Persona";
}

<div class="container py-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
            <h4 class="fw-bold text-primary mb-3">
                <i class="bi bi-person-plus-fill me-2"></i>Crear nueva persona
            </h4>

            <form asp-controller="CreatePerson" asp-action="CreatePerson" method="post">
                <div class="form-floating mb-3">
                    <input type="text" name="name" class="form-control" placeholder="Nombre completo" required />
                    <label>Nombre de la persona</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Crear
                </button>

                <a href="@Url.Action("PersonList", "PersonList")"
                   class="btn btn-outline-secondary w-100 mt-2 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success mt-3 text-center rounded-3">@ViewBag.Success</div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 text-center rounded-3">@ViewBag.Error</div>
                }
            </form>
        </div>
    </div>
</div>
