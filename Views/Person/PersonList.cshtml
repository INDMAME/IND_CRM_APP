@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*
    ╔═══════════════════════════════════════════════════════════════════╗
    ║ VISTA: LISTADO DE PERSONAS                                        ║
    ║-------------------------------------------------------------------║
    ║ - Carga datos desde la API Axapta (endpoint GetPersonsJson).      ║
    ║ - Implementa búsqueda por nombre o código.                        ║
    ║ - Permite limpiar caché y muestra tiempos de carga.               ║
    ║ - Usa JavaScript para peticiones fetch asincrónicas.              ║
    ╚═══════════════════════════════════════════════════════════════════╝
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listado de Personas";
}

<div class="container py-5">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-primary mb-0">
                <i class="bi bi-people-fill me-2"></i>Listado de Personas
            </h3>
            <p class="text-muted small mb-0">
                Datos obtenidos de Axapta 3.0 — Ambiente:
                <strong>@Html.Raw(ViewBag.Environment ?? "Desconocido")</strong>
            </p>
        </div>

        <!-- Nueva Persona -->
        <a href="@Url.Action("CreatePerson", "CreatePerson")" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Nueva Persona
        </a>
    </div>

    <!-- Contador -->
    <div class="text-center mb-4">
        <span id="personCounter" class="badge bg-secondary fs-6 me-2">0 personas</span>
        <span id="loadTime" class="text-muted small">Tiempo de carga: —</span>
    </div>

    <!-- Loader -->
    <div id="loadingIndicator" class="text-center py-5" style="display:none;">
        <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;" role="status"></div>
        <p class="text-muted">Cargando personas desde Axapta...</p>
    </div>

    <!-- Búsqueda -->
    <div id="personSearchSection" class="position-relative mx-auto" style="max-width: 400px;">
        <div class="input-group">
            <input id="searchInput" type="text" class="form-control shadow-sm"
                   placeholder="Buscar persona por nombre o código...">
            <button id="searchButton" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <!-- Lista -->
    <ul id="personList" class="list-group shadow-sm mt-3" style="max-height: 500px; overflow-y: auto;"></ul>

    <!-- Indicadores -->
    <div id="statusContainer" class="text-center mt-3"></div>

    <!-- Botón limpiar caché -->
    <div class="text-center mt-2">
        <button id="clearCacheBtn" class="btn btn-sm btn-outline-secondary">
            🗑️ Vaciar caché
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const list = document.getElementById("personList");
            const search = document.getElementById("searchInput");
            const searchBtn = document.getElementById("searchButton");
            const counter = document.getElementById("personCounter");
            const loadTime = document.getElementById("loadTime");
            const loading = document.getElementById("loadingIndicator");
            const statusContainer = document.getElementById("statusContainer");
            const clearCacheBtn = document.getElementById("clearCacheBtn");

            const CACHE_KEY = "personCache";
            const LAST_FILTER_KEY = "lastPersonFilter";
            let cache = new Map(JSON.parse(sessionStorage.getItem(CACHE_KEY) || "[]"));
            let lastFilter = "";

            function setStatus(text, color) {
                statusContainer.innerHTML = `<span class="${color} small">${text}</span>`;
            }

            async function fetchPersons(filter, reset = false) {
                const key = filter.toLowerCase();
                const cached = cache.get(key);

                if (cached) {
                    renderPersons(cached, 0, true);
                    loadTime.textContent = "Tiempo de carga: 0.00s";
                    setStatus("📦 Resultados desde caché", "text-success");
                    return;
                }

                loading.style.display = "block";
                setStatus("🌐 Consultando servidor...", "text-primary");

                const t0 = performance.now();
                const res = await fetch(`/PersonList/GetPersons?filter=${encodeURIComponent(filter)}&skip=0&take=200`);
                const data = await res.json();
                const duration = ((performance.now() - t0) / 1000).toFixed(2);
                loading.style.display = "none";

                const items = data.items ?? [];
                cache.set(key, items);
                saveCache();

                renderPersons(items, data.total ?? 0, reset);
                loadTime.textContent = `Tiempo de carga: ${duration}s`;
                setStatus("🟢 Datos en vivo desde servidor", "text-primary");
            }

            function saveCache() {
                const arr = Array.from(cache.entries());
                sessionStorage.setItem(CACHE_KEY, JSON.stringify(arr));
                if (arr.length > 20) {
                    cache.clear();
                    sessionStorage.removeItem(CACHE_KEY);
                }
            }

            function renderPersons(items, total, reset) {
                if (reset) list.innerHTML = "";
                if (!items?.length) {
                    setStatus("No se encontraron personas.", "text-muted");
                    return;
                }

                counter.textContent = `${total || items.length} personas`;
                for (const p of items) {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action";
                    li.textContent = `${p.id} — ${p.name}`;
                    list.appendChild(li);
                }
            }

            function startSearch() {
                const filter = search.value.trim();
                if (!filter || filter === lastFilter) return;
                lastFilter = filter;
                list.innerHTML = "";
                counter.textContent = "0 personas";
                fetchPersons(filter, true);
            }

            search.addEventListener("keypress", e => {
                if (e.key === "Enter") startSearch();
            });

            searchBtn.addEventListener("click", startSearch);

            clearCacheBtn.addEventListener("click", () => {
                cache.clear();
                sessionStorage.removeItem(CACHE_KEY);
                sessionStorage.removeItem(LAST_FILTER_KEY);
                setStatus("🗑️ Caché vaciada.", "text-muted");
            });

            // Recuperar última búsqueda
            const last = sessionStorage.getItem(LAST_FILTER_KEY);
            if (last) {
                search.value = last;
                lastFilter = last;
                fetchPersons(last, true);
            }

            // Guardar última búsqueda al salir
            window.addEventListener("beforeunload", () => {
                sessionStorage.setItem(LAST_FILTER_KEY, lastFilter);
            });
        });
    </script>
}
