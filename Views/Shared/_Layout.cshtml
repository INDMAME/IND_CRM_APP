@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpAccessor

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IND CRM</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- CSS GLOBAL DEL LAYOUT -->
    <link rel="stylesheet" href="~/css/layout.css" />

    <!-- CSS ESPECÍFICO DE CADA VISTA -->
    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- FRANJA SUPERIOR FIJA -->
    <div class="topbar shadow-sm">
        <div class="topbar-left">
            <!-- BOTÓN HAMBURGUESA -->
            <button id="btnMenu" class="hamburger" aria-label="Abrir menú" onclick="toggleSidebar()">
                <i class="bi bi-list"></i>
            </button>

            <!-- Flechas de navegación -->
            <div class="topbar-nav">
                <button id="globalBackBtn" class="topbar-btn" aria-label="Retroceder" style="display:none;">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button id="globalForwardBtn" class="topbar-btn" aria-label="Avanzar" style="display:none;">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
        <div class="topbar-right">
            @RenderSection("TopBarRight", required: false)
        </div>
    </div>

    <!-- OVERLAY -->
    <div id="overlay" class="overlay" onclick="toggleSidebar()"></div>

    <!-- SIDEBAR -->
    <div id="sidebar" class="sidebar">

        <!-- BOTÓN X DENTRO DEL SIDEBAR -->
        <button class="close-sidebar" aria-label="Cerrar menú" onclick="toggleSidebar()">
            <i class="bi bi-x"></i>
        </button>

        <!-- LOGO -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-logo">
            <img src="~/images/insertec-logo-white.jpg" alt="Logo Insertec" />
        </a>

        <!-- MENÚ PRINCIPAL -->
        <a href="#" onclick="toggleVisitas(); return false;">Visitas</a>

        <div id="submenuVisitas" class="submenu">
            <a asp-controller="Visitas" asp-action="Create">Crear visita</a>

            <!-- ✔ Ruta correcta para historial -->
            <a asp-controller="Historial" asp-action="History">
                Historial
            </a>
        </div>


        <!-- PANEL USUARIO -->
        @{
            var displayUser = HttpAccessor.HttpContext?.Session.GetString("AxUser")
                              ?? HttpAccessor.HttpContext?.Session.GetString("Username")
                              ?? "Usuario";
        }
        <div class="user-panel">

            <!-- CHIP DEL USUARIO -->
            <div class="user-chip" onclick="toggleUserMenu()">
                <i class="bi bi-person-fill user-chip-icon"></i>

                <span class="username-text">
                    @displayUser.ToUpperInvariant()
                </span>

                <i id="userMenuChevron" class="bi bi-chevron-up ms-2 user-chip-chevron"></i>
            </div>

            <!-- MENÚ DESPLEGABLE DEL USUARIO -->
            <div id="userMenu" class="user-menu mt-2">
                <div class="px-3 py-2 text-white-50 small">
                    Conectado como <strong>@displayUser</strong>
                </div>

                <a href="#" class="user-menu-item">
                    <i class="bi bi-person-lines-fill me-2"></i> Mis datos
                </a>

                <a href="#" class="user-menu-item">
                    <i class="bi bi-gear-fill me-2"></i> Ajustes
                </a>

                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                    <button type="submit" class="user-menu-item user-menu-logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                    </button>
                </form>

            </div>

        </div>

    </div>

    <!-- ÁREA DE CONTENIDO PRINCIPAL -->
    <div id="content" class="content">
        @RenderBody()
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("overlay");
        const content = document.getElementById("content");
        const btnMenu = document.getElementById("btnMenu");

        let menuOpen = false;

        function toggleSidebar() {
            menuOpen = !menuOpen;

            if (menuOpen) {
                sidebar.classList.add("open");
                overlay.classList.add("visible");
                btnMenu.style.opacity = "0";
                btnMenu.style.pointerEvents = "none";

                if (window.innerWidth > 768) {
                    content.classList.add("shifted");
                }
            } else {
                sidebar.classList.remove("open");
                overlay.classList.remove("visible");
                btnMenu.style.opacity = "1";
                btnMenu.style.pointerEvents = "auto";
                content.classList.remove("shifted");
            }
        }

        // Submenú de Visitas
        function toggleVisitas() {
            const sub = document.getElementById("submenuVisitas");
            sub.style.display = (sub.style.display === "block") ? "none" : "block";
        }

        // Menú desplegable del usuario
        function toggleUserMenu() {
            const menu = document.getElementById("userMenu");
            const chevron = document.getElementById("userMenuChevron");

            const isOpen = menu.classList.toggle("open");

            if (isOpen) {
            chevron.classList.remove("bi-chevron-up");
            chevron.classList.add("bi-chevron-down");
            } else {
                chevron.classList.remove("bi-chevron-down");
                chevron.classList.add("bi-chevron-up");
            }

        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
