@model IND_CRM_APP.Models.Shared.LoginRequest
@using IND_CRM_APP.Infrastructure.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR
@{
    Layout = null;
    var forceEntra = ViewBag.ForceEntra == true;
    var systemVersion = "0.5";
    var cspNonce = Context?.Items["CspNonce"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" class="h-full bg-primary">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@SR["Login_Title"] - IND CRM</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/tailwind.css" rel="stylesheet" asp-append-version="true" />

    <style>
        .login-grid {
            background-color: #00296b;
            background-image:
                linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 28px 28px;
            opacity: 0.5;
        }

        .login-card {
            box-shadow: 0 22px 45px rgba(2, 24, 60, 0.35);
        }
    </style>
</head>

<body class="min-h-screen bg-primary text-slate-100 font-sans">
    <div class="absolute inset-0 bg-primary"></div>
    <div class="absolute inset-0 login-grid"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#001f4d] opacity-80"></div>

    <div class="relative flex min-h-screen items-center justify-center px-4">
        <div class="w-full max-w-[360px] sm:max-w-[400px]">
            <div class="login-card bg-white border border-slate-100 rounded-2xl px-6 py-12 min-h-[460px] flex flex-col items-center">
                <div class="flex flex-col items-center gap-4 mt-2 mb-16">
                    <img src="~/images/insertec_sin_fondo.png" alt="Insertec" class="h-[100px] w-auto max-w-[240px] object-contain drop-shadow-lg" />
                </div>

                @if (TempData["AuthError"] != null)
                {
                    <div class="bg-red-50 text-red-700 text-sm rounded-xl px-3 py-2 mb-3 border border-red-100">
                        @TempData["AuthError"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-red-700 text-sm rounded-xl px-3 py-2 mb-3 border border-red-100">
                        @ViewBag.Error
                    </div>
                }

                <a asp-controller="Auth"
                   asp-action="EntraLogin"
                   asp-route-force="@(forceEntra ? "true" : null)"
                   class="w-full max-w-[260px] mx-auto inline-flex items-center justify-center gap-3 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-primary/90 transition mt-10">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-md">
                        <svg viewBox="0 0 48 48" class="h-4 w-4" aria-hidden="true">
                            <rect x="4" y="4" width="18" height="18" fill="#f25022"></rect>
                            <rect x="26" y="4" width="18" height="18" fill="#7fba00"></rect>
                            <rect x="4" y="26" width="18" height="18" fill="#00a4ef"></rect>
                            <rect x="26" y="26" width="18" height="18" fill="#ffb900"></rect>
                        </svg>
                    </span>
                    @SR["Login_SignInMicrosoft"]
                </a>

                <div class="mt-auto w-full border-t border-slate-100 pt-3 text-[10px] uppercase tracking-[0.22em] text-slate-400 flex items-center justify-between">
                    <span>@SR["Login_SystemVersion", systemVersion]</span>
                    <span class="inline-flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-md bg-emerald-500"></span>
                        @SR["Login_Secure"]
                    </span>
                </div>
            </div>

            <div class="mt-6 text-center text-[11px] text-white/70">
                @SR["Login_Copyright", DateTime.UtcNow.Year]
            </div>
        </div>
    </div>

    @{
        try
        {
            await Html.PartialAsync("_IndActionMark");
        }
        catch
        {
            // Defensive: do not break login when partial is unavailable.
        }
    }

    <script nonce="@cspNonce" src="~/js/ind-action-mark.js" asp-append-version="true"></script>

    @{
        try
        {
            await Html.PartialAsync("_IndActionMarkInit");
        }
        catch
        {
            // Defensive: do not break login when partial is unavailable.
        }
    }
</body>
</html>
