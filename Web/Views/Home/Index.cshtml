@using IND_CRM_APP.Infrastructure.Localization
@using System.Text.Json
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

@{
    ViewData["Title"] = SR["Home_Title"];
    ViewData["ContentClass"] = "content w-full max-w-5xl mx-auto px-4 md:px-6 flex flex-col";

    var environmentName = ((ViewBag.Environment ?? SR["Common_Unknown"].Value).ToString() ?? string.Empty).Trim();
    var companyName = ((ViewBag.Company ?? SR["Common_NotAvailable"].Value).ToString() ?? string.Empty).Trim();
    var environmentLabel = SR["Home_Environment"].Value;
    var helpAssistantEnabled = ViewBag.CrmHelpAssistantEnabled is bool enabled && enabled;
    var cultureFeature = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = cultureFeature?.RequestCulture.UICulture.Name ?? "es-ES";
    var cspNonce = Context.Items["CspNonce"]?.ToString() ?? string.Empty;
    var isDevEnvironment =
        environmentName.Equals("DEV", StringComparison.OrdinalIgnoreCase)
        || environmentName.Equals("Development", StringComparison.OrdinalIgnoreCase)
        || environmentName.StartsWith("DEV-", StringComparison.OrdinalIgnoreCase)
        || environmentName.StartsWith("DEV_", StringComparison.OrdinalIgnoreCase);
}

<div class="relative isolate flex flex-1 items-stretch py-4 md:py-8">
    @if (helpAssistantEnabled)
    {
        <div id="home-help-assistant-root"
             class="relative z-10 flex min-h-0 w-full"
             data-response-locale="@currentCulture"
             data-environment-label="@environmentLabel"
             data-environment-name="@environmentName"
             data-company-name="@companyName"
             data-is-dev="@isDevEnvironment.ToString().ToLowerInvariant()"
             data-assistant-launcher-animated-webp="@Url.Content("~/assets/kaloria/furnace/animated/kaloria-furnace.webp")"
             data-assistant-launcher-animated-gif="@Url.Content("~/assets/kaloria/furnace/animated/kaloria-furnace.gif")"
             data-assistant-launcher-reduced-motion-png="@Url.Content("~/assets/kaloria/furnace/static/kaloria-furnace-static.png")"></div>
    }
    else
    {
        <section class="relative z-10 flex w-full flex-col overflow-hidden rounded-[var(--radius-xl)] border border-slate-200 bg-white/95 shadow-[0_18px_45px_rgba(15,23,42,0.08)]">
            @if (isDevEnvironment)
            {
                <div class="pointer-events-none absolute inset-0 flex items-center justify-center" role="status" aria-label="@($"{environmentLabel}: DEV")">
                    <span class="select-none text-[8.5rem] font-black uppercase leading-none tracking-normal text-slate-100 sm:text-[11rem] md:text-[15rem]" translate="no" aria-hidden="true">DEV</span>
                </div>
            }
            <div class="tech-info relative z-10 mt-auto border-t border-slate-100 px-5 py-4 text-center space-y-1 leading-tight">
                @if (!isDevEnvironment)
                {
                    <div>@environmentLabel: @environmentName</div>
                }
                <div>Microsoft Navision Axapta 3.0</div>
                <div><strong>@companyName</strong></div>
            </div>
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/technical-info.css" />
}

@if (helpAssistantEnabled)
{
    <script nonce="@cspNonce">
        window.__IND_I18N__ = Object.assign(window.__IND_I18N__ || {}, @Html.Raw(JsonSerializer.Serialize(new
        {
            HomeHelp_CardTitle = SR["HomeHelp_CardTitle"].Value,
            HomeHelp_CardBody = SR["HomeHelp_CardBody"].Value,
            HomeHelp_OpenAria = SR["HomeHelp_OpenAria"].Value,
            HomeHelp_Callout1 = SR["HomeHelp_Callout1"].Value,
            HomeHelp_Callout2 = SR["HomeHelp_Callout2"].Value,
            HomeHelp_Callout3 = SR["HomeHelp_Callout3"].Value,
            HomeHelp_Suggestion1 = SR["HomeHelp_Suggestion1"].Value,
            HomeHelp_Suggestion2 = SR["HomeHelp_Suggestion2"].Value,
            HomeHelp_Suggestion3 = SR["HomeHelp_Suggestion3"].Value,
            HomeHelp_ChatLoading = SR["HomeHelp_ChatLoading"].Value,
            HomeHelp_RenderError = SR["HomeHelp_RenderError"].Value,
            HomeHelp_PanelTitle = SR["HomeHelp_PanelTitle"].Value,
            HomeHelp_MoveWindow = SR["HomeHelp_MoveWindow"].Value,
            HomeHelp_ResizeWindow = SR["HomeHelp_ResizeWindow"].Value,
            HomeHelp_Send = SR["HomeHelp_Send"].Value,
            HomeHelp_Sending = SR["HomeHelp_Sending"].Value,
            HomeHelp_Retry = SR["HomeHelp_Retry"].Value,
            HomeHelp_Warnings = SR["HomeHelp_Warnings"].Value,
            HomeHelp_InputPlaceholder = SR["HomeHelp_InputPlaceholder"].Value,
            HomeHelp_InputPrivacyNotice = SR["HomeHelp_InputPrivacyNotice"].Value,
            HomeHelp_EmptyTitle = SR["HomeHelp_EmptyTitle"].Value,
            HomeHelp_EmptyBody = SR["HomeHelp_EmptyBody"].Value,
            HomeHelp_NoContextTitle = SR["HomeHelp_NoContextTitle"].Value,
            HomeHelp_NoContextBody = SR["HomeHelp_NoContextBody"].Value,
            HomeHelp_NoContextMessage = SR["HomeHelp_NoContextMessage"].Value,
            HomeHelp_CatalogLoading = SR["HomeHelp_CatalogLoading"].Value,
            HomeHelp_CatalogError = SR["HomeHelp_CatalogError"].Value,
            HomeHelp_CatalogEmpty = SR["HomeHelp_CatalogEmpty"].Value,
            HomeHelp_ModuleSelectionTitle = SR["HomeHelp_ModuleSelectionTitle"].Value,
            HomeHelp_ModuleSelectionBody = SR["HomeHelp_ModuleSelectionBody"].Value,
            HomeHelp_ModuleSelectionLocked = SR["HomeHelp_ModuleSelectionLocked"].Value,
            HomeHelp_ChangeModule = SR["HomeHelp_ChangeModule"].Value,
            HomeHelp_TopicQuestionTemplate = SR["HomeHelp_TopicQuestionTemplate"].Value,
            HomeHelp_Loading = SR["HomeHelp_Loading"].Value,
            HomeHelp_ErrorRateLimit = SR["HomeHelp_ErrorRateLimit"].Value,
            HomeHelp_ErrorRequest = SR["HomeHelp_ErrorRequest"].Value,
            HomeHelp_ErrorAiUnavailable = SR["HomeHelp_ErrorAiUnavailable"].Value,
            HomeHelp_ErrorAiRateLimit = SR["HomeHelp_ErrorAiRateLimit"].Value,
            HomeHelp_ErrorFeatureDisabled = SR["HomeHelp_ErrorFeatureDisabled"].Value,
            HomeHelp_ErrorKnowledgeUnavailable = SR["HomeHelp_ErrorKnowledgeUnavailable"].Value,
            HomeHelp_ErrorRewriteRequired = SR["HomeHelp_ErrorRewriteRequired"].Value,
            HomeHelp_ErrorReference = SR["HomeHelp_ErrorReference"].Value,
            HomeHelp_NeedsSelection = SR["HomeHelp_NeedsSelection"].Value,
            HomeHelp_NotDocumented = SR["HomeHelp_NotDocumented"].Value,
            HomeHelp_SourcesLabel = SR["HomeHelp_SourcesLabel"].Value,
            HomeHelp_SourceLoading = SR["HomeHelp_SourceLoading"].Value,
            HomeHelp_SourceError = SR["HomeHelp_SourceError"].Value,
            HomeHelp_Navigate = SR["HomeHelp_Navigate"].Value,
            HomeHelp_QuickAnswer = SR["HomeHelp_QuickAnswer"].Value,
            HomeHelp_FeedbackPrompt = SR["HomeHelp_FeedbackPrompt"].Value,
            HomeHelp_HelpfulAria = SR["HomeHelp_HelpfulAria"].Value,
            HomeHelp_NotHelpfulAria = SR["HomeHelp_NotHelpfulAria"].Value,
            HomeHelp_FeedbackReasonLabel = SR["HomeHelp_FeedbackReasonLabel"].Value,
            HomeHelp_FeedbackReasonPlaceholder = SR["HomeHelp_FeedbackReasonPlaceholder"].Value,
            HomeHelp_FeedbackReason_incorrect = SR["HomeHelp_FeedbackReason_incorrect"].Value,
            HomeHelp_FeedbackReason_outdated = SR["HomeHelp_FeedbackReason_outdated"].Value,
            HomeHelp_FeedbackReason_unclear = SR["HomeHelp_FeedbackReason_unclear"].Value,
            HomeHelp_FeedbackReason_incomplete = SR["HomeHelp_FeedbackReason_incomplete"].Value,
            HomeHelp_FeedbackReason_permissions = SR["HomeHelp_FeedbackReason_permissions"].Value,
            HomeHelp_FeedbackReason_other = SR["HomeHelp_FeedbackReason_other"].Value,
            HomeHelp_FeedbackCommentLabel = SR["HomeHelp_FeedbackCommentLabel"].Value,
            HomeHelp_FeedbackCommentPlaceholder = SR["HomeHelp_FeedbackCommentPlaceholder"].Value,
            HomeHelp_FeedbackSubmit = SR["HomeHelp_FeedbackSubmit"].Value,
            HomeHelp_FeedbackSending = SR["HomeHelp_FeedbackSending"].Value,
            HomeHelp_FeedbackThanks = SR["HomeHelp_FeedbackThanks"].Value,
            HomeHelp_FeedbackError = SR["HomeHelp_FeedbackError"].Value,
            Common_Close = SR["Common_Close"].Value,
            Common_NotAvailable = SR["Common_NotAvailable"].Value,
            Api_RequestFailed = SR["Api_RequestFailed"].Value
        })));
    </script>
    <script nonce="@cspNonce" type="module" src="~/js/home-help.js" asp-append-version="true"></script>
}
