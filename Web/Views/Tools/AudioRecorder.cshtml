@using System.Text.Json
@using IND_CRM_APP.Infrastructure.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

@{
    ViewData["Title"] = SR["Tools_AudioRecorder_Title"];
    var cspNonce = Context?.Items["CspNonce"]?.ToString() ?? string.Empty;
}

<div id="ind-audio-recorder-root"></div>

@section Scripts {
    <script nonce="@cspNonce">
        window.__IND_I18N__ = @Html.Raw(JsonSerializer.Serialize(new {
            Tools_AudioRecorder_Title = SR["Tools_AudioRecorder_Title"].Value,
            TextEditor_Transcribe = SR["TextEditor_Transcribe"].Value,
            TextEditor_Transcribing = SR["TextEditor_Transcribing"].Value,

            AudioRecorder_Play = SR["AudioRecorder_Play"].Value,
            AudioRecorder_Record = SR["AudioRecorder_Record"].Value,
            AudioRecorder_Pause = SR["AudioRecorder_Pause"].Value,
            AudioRecorder_Resume = SR["AudioRecorder_Resume"].Value,
            AudioRecorder_Stop = SR["AudioRecorder_Stop"].Value,
            AudioRecorder_Cancel = SR["AudioRecorder_Cancel"].Value,
            AudioRecorder_NoAudio = SR["AudioRecorder_NoAudio"].Value,
            AudioRecorder_Download = SR["AudioRecorder_Download"].Value,
            AudioRecorder_Download_FileName = SR["AudioRecorder_Download_FileName"].Value,
            AudioRecorder_Status_Recording = SR["AudioRecorder_Status_Recording"].Value,
            AudioRecorder_Status_Paused = SR["AudioRecorder_Status_Paused"].Value,
            AudioRecorder_Status_ReadyToPlay = SR["AudioRecorder_Status_ReadyToPlay"].Value,
            AudioRecorder_Status_Ready = SR["AudioRecorder_Status_Ready"].Value,

            AudioRecorder_Error_HttpBlocked = SR["AudioRecorder_Error_HttpBlocked"].Value,
            AudioRecorder_Error_PermissionDenied = SR["AudioRecorder_Error_PermissionDenied"].Value,
            AudioRecorder_Error_NoDevice = SR["AudioRecorder_Error_NoDevice"].Value,
            AudioRecorder_Error_DeviceBusy = SR["AudioRecorder_Error_DeviceBusy"].Value,
            AudioRecorder_Error_Security = SR["AudioRecorder_Error_Security"].Value,
            AudioRecorder_Error_Constraints = SR["AudioRecorder_Error_Constraints"].Value,
            AudioRecorder_Error_Generic = SR["AudioRecorder_Error_Generic"].Value,
            AudioRecorder_Error_Unsupported = SR["AudioRecorder_Error_Unsupported"].Value,
            AudioRecorder_Error_NoAudioContext = SR["AudioRecorder_Error_NoAudioContext"].Value,

            AudioRecorder_Hint_Origin = SR["AudioRecorder_Hint_Origin"].Value,
            AudioRecorder_Hint_Technical = SR["AudioRecorder_Hint_Technical"].Value
        }));
    </script>
    <script nonce="@cspNonce" type="module" defer src="~/js/audio-recorder.js" asp-append-version="true"></script>
}

