@model IND_CRM_APP.Models.ViewModels.ModalViewModel
@using IND_CRM_APP.Infrastructure.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

<div id="@Model.Id" class="fixed inset-0 z-2100 hidden items-center justify-center px-4 sm:px-6" role="dialog" aria-modal="true" aria-labelledby="@Model.Id-Title">
    <div class="fixed inset-0 bg-black/50 transition-opacity" aria-hidden="true"></div>

    <div class="relative w-full max-w-lg transform rounded-2xl bg-white shadow-2xl transition-all">
        <div class="flex items-start justify-between px-5 py-4 border-b border-slate-200">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 30 30" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9.75v3.75m-9 0a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z" />
                </svg>
                <h2 id="@Model.Id-Title" class="text-lg font-semibold text-slate-900">@Model.Title</h2>
            </div>
            @if (Model.ShowCloseButton)
            {
                <button type="button" class="text-slate-500 hover:text-slate-700 transition" aria-label="@SR["Common_Close"]" data-ind-modal-close="@Model.Id">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 30 30" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>

        <div class="px-5 py-4 space-y-3">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-sm text-slate-600">@Model.Description</p>
            }

            @if (Model.Body != null)
            {
                @Model.Body
            }
        </div>

        <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-slate-200">
            @if (Model.SecondaryText != null)
            {
                <button type="button" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition @Model.SecondaryButtonCss" data-ind-modal-close="@Model.Id">
                    @(string.IsNullOrWhiteSpace(Model.SecondaryText) ? SR["Common_Cancel"] : Model.SecondaryText)
                </button>
            }
            <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary/90 transition @Model.PrimaryButtonCss">
                @(string.IsNullOrWhiteSpace(Model.PrimaryText) ? SR["Common_OK"] : Model.PrimaryText)
            </button>
        </div>
    </div>
</div>
