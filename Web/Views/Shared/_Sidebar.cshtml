@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpAccessor
@using IND_CRM_APP.Infrastructure.Localization
@using IND_CRM_APP.Models.Shared
@using IND_CRM_APP.Infrastructure.Security.Modules
@using IND_CRM_APP.Infrastructure.Security.Permissions
@using System.Text.Json
@using System.Linq
@using System.Collections.Generic
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

@{
    var returnUrl = (Context?.Request?.Path.Value ?? "/") + (Context?.Request?.QueryString.Value ?? string.Empty);
    var cultureFeature = Context?.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = cultureFeature?.RequestCulture?.UICulture?.Name ?? System.Globalization.CultureInfo.CurrentUICulture.Name;

    IndWebContext? webContext = null;
    var contextRaw = HttpAccessor.HttpContext?.Session.GetString("INDWebContext");
    if (!string.IsNullOrWhiteSpace(contextRaw))
    {
        try
        {
            webContext = JsonSerializer.Deserialize<IndWebContext>(contextRaw);
        }
        catch
        {
            webContext = null;
        }
    }

    var axUserId = webContext?.Header?.AxUserId;
    var displayUser = !string.IsNullOrWhiteSpace(axUserId)
        ? axUserId
        : (HttpAccessor.HttpContext?.Session.GetString("AxUser")
           ?? SR["Common_User"].Value);

    var selectedCompanyId = HttpAccessor.HttpContext?.Session.GetString("INDCompanySelected");
    var companySelectionSource = HttpAccessor.HttpContext?.Session.GetString("INDCompanySelectionSource");
    if (string.IsNullOrWhiteSpace(selectedCompanyId) &&
        !string.Equals(companySelectionSource, "user", StringComparison.OrdinalIgnoreCase))
    {
        selectedCompanyId = webContext?.Header.DefaultCompany;
    }
    var companies = webContext?.Companies ?? new List<IndWebCompany>();
    var selectedCompany = !string.IsNullOrWhiteSpace(selectedCompanyId)
        ? companies.FirstOrDefault(c => string.Equals(c.CompanyId, selectedCompanyId, StringComparison.OrdinalIgnoreCase))
        : companies.FirstOrDefault();

    var selectedCompanyLabel = selectedCompany?.CompanyId ?? selectedCompany?.CompanyName ?? string.Empty;
    var selectedLanguageNameKey = currentCulture switch
    {
        "es-ES" => "Language_ES_Name",
        "eu-ES" => "Language_EU_Name",
        "en" => "Language_EN_Name",
        "pt" => "Language_PT_Name",
        "it" => "Language_IT_Name",
        "zh-Hans" => "Language_ZH_Name",
        _ => "Language_EN_Name"
    };
    var selectedLanguageName = SR[selectedLanguageNameKey].Value;

    bool HasModuleAccess(string moduleCode, int minAccess)
    {
        if (selectedCompany == null || selectedCompany.Modules == null)
            return false;

        var mod = selectedCompany.Modules.FirstOrDefault(m =>
            INDModuleRegistry.MatchesModuleCode(m.ModuleCode, moduleCode));
        return mod != null && mod.AccessRightsInt >= minAccess;
    }

    var canCreateVisit = HasModuleAccess(INDModuleRegistry.ModuleVisitasCreacion, IndAccessRights.Add);
    var canViewHistory = HasModuleAccess(INDModuleRegistry.ModuleVisitasHistorial, IndAccessRights.View);
    var canViewExpenseSheets = HasModuleAccess(INDModuleRegistry.ModuleGastosHojaGasto, IndAccessRights.View);
}

<div id="sidebar" class="sidebar fixed top-0 left-0 z-2000 flex min-h-screen w-[260px] flex-col bg-primary text-white transform -translate-x-[260px] transition-transform duration-300" aria-hidden="true">

    <button id="sidebarCloseBtn" type="button" class="close-sidebar absolute top-4 right-4 text-2xl hover:rotate-90 transition" aria-label="@SR["Sidebar_CloseMenu"]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 30 30" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
    </button>

    <a asp-controller="Home" asp-action="Index" class="sidebar-logo mt-6 mb-6 flex flex-col items-center text-center hover:scale-[1.02] transition">
        <img src="~/images/insertec_logo_blanco.png" alt="@SR["Common_AppLogoAlt"]" />
    </a>

    @if (canCreateVisit || canViewHistory)
    {
        <button id="visitasToggle" type="button" class="w-full text-left px-6 py-3 text-sm font-semibold tracking-wide hover:bg-white/15 transition flex items-center justify-between" aria-controls="submenuVisitas" aria-expanded="false">
            <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/90" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                @SR["Nav_Visits"].Value.ToUpperInvariant()
            </span>
            <svg id="visitasChevron" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/80 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </button>

        <div id="submenuVisitas" class="submenu ml-4 hidden" aria-label="@SR["Nav_Visits"].Value">
            @if (canCreateVisit)
            {
                <a asp-controller="Visitas" asp-action="Create" asp-route-fresh="1" class="block px-6 py-1 text-sm hover:bg-white/15 transition">
                    <span class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/85" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        @SR["Nav_Visits_Create"]
                    </span>
                </a>
            }
            @if (canViewHistory)
            {
                <a asp-controller="Historial" asp-action="History" class="block px-6 py-1 text-sm hover:bg-white/15 transition">
                    <span class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/85" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                            <path d="M3 3v5h5" />
                            <path d="M12 7v5l4 2" />
                        </svg>
                        @SR["Nav_Visits_History"]
                    </span>
                </a>
            }
        </div>
    }

    @if (canViewExpenseSheets)
    {
        <button id="gastosToggle" type="button" class="w-full text-left px-6 py-3 text-sm font-semibold tracking-wide hover:bg-white/15 transition flex items-center justify-between" aria-controls="submenuGastos" aria-expanded="false">
            <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                </svg>
                @SR["Nav_Expenses"].Value.ToUpperInvariant()
            </span>
            <svg id="gastosChevron" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/80 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </button>

        <div id="submenuGastos" class="submenu ml-4 hidden" aria-label="@SR["Nav_Expenses"].Value">
            <a asp-controller="Gastos" asp-action="ExpenseSheets" class="block px-6 py-1 text-sm hover:bg-white/15 transition">
                <span class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/85" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                    @SR["Nav_ExpenseSheets"]
                </span>
            </a>
        </div>
    }

    <div class="user-panel mt-auto px-6 pb-8 relative">
        <button id="userMenuToggle" type="button" class="user-chip flex items-center gap-2 px-3 py-2 rounded-xl cursor-pointer transition hover:bg-white/10" aria-expanded="false" aria-controls="userMenu">
            <svg xmlns="http://www.w3.org/2000/svg" class="user-chip-icon h-5 w-5" fill="none" viewBox="0 0 30 30" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5a7.5 7.5 0 1 1 15 0" />
            </svg>
            <span class="username-text">@displayUser.ToUpperInvariant()</span>
            <svg id="userMenuChevron" xmlns="http://www.w3.org/2000/svg" class="ms-2 user-chip-chevron h-4 w-4 transition-transform duration-150" fill="none" viewBox="0 0 30 30" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </button>

        <div id="userMenu" class="user-menu dropup-menu bg-transparent border border-white/30 rounded-lg opacity-0 pointer-events-none transition duration-150 transform translate-y-2">
            <div class="mt-1">
                @if (companies.Count > 0)
                {
                    <button id="indCompanyButton"
                            type="button"
                            class="user-menu-item flex items-center w-full text-left px-3 py-2 text-sm hover:bg-white/15 transition"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-controls="indCompanySubmenu">
                        <svg xmlns="http://www.w3.org/2000/svg" class="me-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15l.75 6H3.75L4.5 3Zm0 6h15v9h-15V9Z" />
                        </svg>
                        <span class="flex-1">@SR["UserMenu_Companies"]</span>
                        <span class="ml-2 text-xs text-white/80">@selectedCompanyLabel</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="ms-2 h-4 w-4 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                        </svg>
                    </button>

                    <div id="indCompanySubmenu" class="hidden">
                        @foreach (var company in companies)
                        {
                            var isSelected = string.Equals(company.CompanyId, selectedCompanyId, StringComparison.OrdinalIgnoreCase);
                            var companyLabel = !string.IsNullOrWhiteSpace(company.CompanyId) ? company.CompanyId : company.CompanyName;
                            <form asp-controller="INDCompany" asp-action="SetCompany" method="post" class="m-0 ind-company-form" data-company-id="@company.CompanyId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@company.CompanyId" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit"
                                        class="user-menu-item flex items-center w-full text-left px-3 py-2 text-xs hover:bg-white/15 transition"
                                        style="padding-left: 28px;"
                                        aria-label="@companyLabel">
                                    <span class="flex-1">@companyLabel</span>
                                    @if (isSelected)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                        </svg>
                                    }
                                </button>
                            </form>
                        }
                    </div>

                    <div class="mt-1 border-t border-white/10"></div>
                }

                <button id="indLangButton"
                        type="button"
                        class="user-menu-item flex items-center w-full text-left px-3 py-2 text-sm hover:bg-white/15 transition"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="indLangSubmenu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="me-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                    </svg>
                    <span class="flex-1">@SR["UserMenu_Languages"]</span>
                    <span class="ml-2 text-xs text-white/80">@selectedLanguageName</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="ms-2 h-4 w-4 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <div id="indLangSubmenu" class="hidden">
                    @foreach (var item in new[]
                    {
                        new { Culture = "es-ES", CodeKey = "Language_ES", NameKey = "Language_ES_Name" },
                        new { Culture = "eu-ES", CodeKey = "Language_EU", NameKey = "Language_EU_Name" },
                        new { Culture = "en", CodeKey = "Language_EN", NameKey = "Language_EN_Name" },
                        new { Culture = "pt", CodeKey = "Language_PT", NameKey = "Language_PT_Name" },
                        new { Culture = "it", CodeKey = "Language_IT", NameKey = "Language_IT_Name" },
                        new { Culture = "zh-Hans", CodeKey = "Language_ZH", NameKey = "Language_ZH_Name" }
                    })
                    {
                        var isActive = string.Equals(currentCulture, item.Culture, StringComparison.OrdinalIgnoreCase);
                        <form asp-controller="INDLocalization" asp-action="SetCulture" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@item.Culture" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit"
                                    class="user-menu-item flex items-center w-full text-left px-3 py-2 text-sm hover:bg-white/15 transition"
                                    style="padding-left: 28px;"
                                    aria-label="@SR[item.NameKey]">
                                <span class="flex-1">@SR[item.NameKey]</span>
                                @if (isActive)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                    </svg>
                                }
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="mt-1 border-t border-white/10"></div>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="user-menu-item user-menu-logout flex items-center w-full text-left px-3 py-2 text-sm hover:bg-white/15 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="me-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H9.75" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="m15 9 3 3-3 3" />
                    </svg>
                    @SR["UserMenu_Logout"]
                </button>
            </form>
        </div>
    </div>

</div>
