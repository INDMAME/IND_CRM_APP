@using IND_CRM_APP.Infrastructure.Localization
@using IND_CRM_APP.Models.Shared
@using IND_CRM_APP.Infrastructure.Security.Modules
@using IND_CRM_APP.Infrastructure.Security.Permissions
@using System.Linq
@using System.Text.Json
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpAccessor
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

@{
    var title = ViewData["Title"]?.ToString() ?? "IND CRM";
    var path = Context?.Request?.Path.Value ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var isHome = controller.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                 action.Equals("Index", StringComparison.OrdinalIgnoreCase);

    var hideNavArrows = (ViewData["HideNavArrows"] as bool? ?? false) ||
                        path == "/" ||
                        isHome;

    var isHistory = controller.Equals("Historial", StringComparison.OrdinalIgnoreCase) &&
                    action.Equals("History", StringComparison.OrdinalIgnoreCase);

    var isExpenseSheets = controller.Equals("Gastos", StringComparison.OrdinalIgnoreCase) &&
                          action.Equals("ExpenseSheets", StringComparison.OrdinalIgnoreCase);

    var isExpenseSheetDetail = controller.Equals("Gastos", StringComparison.OrdinalIgnoreCase) &&
                               action.Equals("ExpenseSheetDetail", StringComparison.OrdinalIgnoreCase);

    var isExpenseSheetLineDetail = controller.Equals("Gastos", StringComparison.OrdinalIgnoreCase) &&
                                   action.Equals("ExpenseSheetLineDetail", StringComparison.OrdinalIgnoreCase);

    var expenseSheetMode = (ViewBag.ExpenseSheetMode?.ToString() ?? string.Empty).Trim();
    var expenseSheetLineMode = (ViewBag.ExpenseSheetLineMode?.ToString() ?? string.Empty).Trim();
    var isExpenseSheetCreateMode = isExpenseSheetDetail &&
                                   expenseSheetMode.Equals("create", StringComparison.OrdinalIgnoreCase);
    var isExpenseSheetLineCreateMode = isExpenseSheetLineDetail &&
                                       expenseSheetLineMode.Equals("create", StringComparison.OrdinalIgnoreCase);

    var isCreate = controller.Equals("Visitas", StringComparison.OrdinalIgnoreCase) &&
                   action.Equals("Create", StringComparison.OrdinalIgnoreCase);

    var isVisitaDetail = (controller.Equals("Visitas", StringComparison.OrdinalIgnoreCase) &&
                          (action.StartsWith("Detalle", StringComparison.OrdinalIgnoreCase) ||
                           action.StartsWith("Detail", StringComparison.OrdinalIgnoreCase))) ||
                         path.StartsWith("/Visitas/Detalle", StringComparison.OrdinalIgnoreCase);

    IndWebContext? webContext = null;
    var contextRaw = HttpAccessor.HttpContext?.Session.GetString("INDWebContext");
    if (!string.IsNullOrWhiteSpace(contextRaw))
    {
        try
        {
            webContext = JsonSerializer.Deserialize<IndWebContext>(contextRaw);
        }
        catch
        {
            webContext = null;
        }
    }

    var selectedCompanyId = HttpAccessor.HttpContext?.Session.GetString("INDCompanySelected");
    var companySelectionSource = HttpAccessor.HttpContext?.Session.GetString("INDCompanySelectionSource");
    if (string.IsNullOrWhiteSpace(selectedCompanyId) &&
        !string.Equals(companySelectionSource, "user", StringComparison.OrdinalIgnoreCase))
    {
        selectedCompanyId = !string.IsNullOrWhiteSpace(webContext?.Header?.DefaultCompany)
            ? webContext!.Header.DefaultCompany
            : webContext?.Companies?.FirstOrDefault()?.CompanyId;
    }

    IndWebCompany? selectedCompany = null;
    if (webContext?.Companies != null)
    {
        selectedCompany = !string.IsNullOrWhiteSpace(selectedCompanyId)
            ? webContext.Companies.FirstOrDefault(c => string.Equals(c.CompanyId, selectedCompanyId, StringComparison.OrdinalIgnoreCase))
            : webContext.Companies.FirstOrDefault();
    }

    int GetModuleAccess(string moduleCode)
    {
        if (selectedCompany?.Modules == null)
            return 0;

        var mod = selectedCompany.Modules.FirstOrDefault(m =>
            INDModuleRegistry.MatchesModuleCode(m.ModuleCode, moduleCode));
        return mod?.AccessRightsInt ?? 0;
    }

    var historyAccess = GetModuleAccess(INDModuleRegistry.ModuleVisitasHistorial);
    var createAccess = GetModuleAccess(INDModuleRegistry.ModuleVisitasCreacion);
    var expenseAccess = GetModuleAccess(INDModuleRegistry.ModuleGastosHojaGasto);
    var canEditHistory = historyAccess >= IndAccessRights.Edit;
    var canDeleteHistory = historyAccess >= IndAccessRights.FullAccess;
    var canCreateVisit = createAccess >= IndAccessRights.Add;
    var canEditExpense = expenseAccess >= IndAccessRights.Edit;
    var canDeleteExpense = expenseAccess >= IndAccessRights.FullAccess;
    var canCreateExpense = expenseAccess >= IndAccessRights.Add;

    var hideForwardArrow = hideNavArrows || isVisitaDetail || isHistory || isExpenseSheetDetail || isExpenseSheetLineDetail || (isCreate && !canCreateVisit);
    var customBackUrl = ViewData["TopbarBackUrl"]?.ToString() ?? string.Empty;
    var showBackArrow = isVisitaDetail || isExpenseSheetDetail || isExpenseSheetLineDetail || !string.IsNullOrWhiteSpace(customBackUrl);

    var topbarTitle = title;
    if (isHistory)
    {
        topbarTitle = SR["Nav_Visits_History"];
    }
    else if (isExpenseSheets)
    {
        topbarTitle = SR["Nav_ExpenseSheets"];
    }
    else if (isCreate)
    {
        topbarTitle = SR["Common_Create"];
    }
    else if (isVisitaDetail)
    {
        topbarTitle = SR["Visits_Detail_Title"];
    }

    var topbarCompanyTitle = !string.IsNullOrWhiteSpace(selectedCompanyId)
        ? selectedCompanyId.ToUpperInvariant()
        : string.Empty;
}

    <div class="topbar relative sticky top-0 left-0 z-1900 flex h-[64px] w-full items-center justify-between bg-primary text-white px-2 sm:px-2.5 shadow-md transition-[margin,width] duration-300">
        <div class="topbar-left flex items-center gap-1 z-10">
                <button id="btnMenu" type="button" class="topbar-btn pointer-events-auto"
                        aria-label="@SR["Topbar_OpenMenu"]" aria-controls="sidebar" aria-expanded="false">
                    <span class="sr-only">@SR["Topbar_OpenMenu"]</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5" />
                    </svg>
                </button>

            @if (!hideNavArrows && showBackArrow)
            {
                var backUrl = !string.IsNullOrWhiteSpace(customBackUrl)
                    ? customBackUrl
                    : (isVisitaDetail
                        ? "/Historial/History"
                        : (isExpenseSheetDetail ? "/Gastos/ExpenseSheets" : "/Gastos/ExpenseSheets"));
                var backUsesDefault = true;
                <button id="globalBackBtn" type="button" class="topbar-btn pointer-events-auto"
                        aria-label="@SR["Topbar_Back"]"
                        data-back-default="@(backUsesDefault ? "true" : "false")"
                        data-back-url="@backUrl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                </button>
            }
        </div>

        <div class="topbar-center absolute inset-0 flex items-center justify-center pointer-events-none">
            <span id="topbarTitle" class="topbar-title @(string.IsNullOrWhiteSpace(topbarCompanyTitle) ? string.Empty : "topbar-title--with-company")">
                <span class="topbar-title__main">@topbarTitle</span>
                @if (!string.IsNullOrWhiteSpace(topbarCompanyTitle))
                {
                    <span class="topbar-title__company">(@topbarCompanyTitle)</span>
                }
            </span>
        </div>

        <div class="topbar-right flex items-center gap-1 justify-end z-10">
            @if (isHistory || isExpenseSheets)
            {
                var filterDispatch = isHistory ? "history-toggle-filter" : "expense-sheets-toggle-filter";
                var refreshDispatch = isHistory ? "history-refresh" : "expense-sheets-refresh";
                <div class="flex items-center gap-1 pr-1">
                    <button id="historyFilterToggleBtn" type="button" class="topbar-btn pointer-events-auto"
                            aria-label="@SR["History_Filter_Toggle"]"
                            data-ind-dispatch="@filterDispatch">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
                        </svg>
                    </button>
                    <button id="historyRefreshBtn" type="button" class="topbar-btn pointer-events-auto"
                            aria-label="@SR["History_Filter_Refresh"]"
                            data-ind-dispatch="@refreshDispatch">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                    </button>
                </div>
            }
            else if (isVisitaDetail && (canEditHistory || canDeleteHistory))
            {
                <div class="flex items-center gap-1 pr-1">
                    @if (canEditHistory)
                    {
                        <button id="visitEditBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_EditSave"]"
                                data-ind-dispatch="visit-edit">
                            <svg id="visitEditIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                            </svg>
                            <svg id="visitSaveIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </button>
                    }
                    @if (canDeleteHistory)
                    {
                        <button id="visitDeleteBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_Delete"]"
                                data-ind-dispatch="visit-delete">
                            <svg id="visitDeleteIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084A2.25 2.25 0 0 1 5.84 19.673L4.772 5.79m14.456 0a48.11 48.11 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.111 48.111 0 0 1 3.478-.397m7.5 0V4.5c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0C9.548 2.336 8.638 3.32 8.638 4.5v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                        <button id="visitCancelBtn" type="button" class="topbar-btn pointer-events-auto topbar-hidden"
                                aria-label="@SR["Common_Cancel"]"
                                data-ind-dispatch="visit-cancel-edit"
                                style="padding:0;">
                            <svg id="visitCancelIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            }
            else if (isExpenseSheetDetail && (canEditExpense || canDeleteExpense || (isExpenseSheetCreateMode && canCreateExpense)))
            {
                <div class="flex items-center gap-1 pr-1">
                    @if (canEditExpense || (isExpenseSheetCreateMode && canCreateExpense))
                    {
                        <button id="expenseEditBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_EditSave"]"
                                data-ind-dispatch="expense-detail-edit">
                            <svg id="expenseEditIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                            </svg>
                            <svg id="expenseSaveIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </button>
                    }
                    @if (!isExpenseSheetCreateMode && canDeleteExpense)
                    {
                        <button id="expenseDeleteBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_Delete"]"
                                data-ind-dispatch="expense-detail-delete">
                            <svg id="expenseDeleteIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084A2.25 2.25 0 0 1 5.84 19.673L4.772 5.79m14.456 0a48.11 48.11 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.111 48.111 0 0 1 3.478-.397m7.5 0V4.5c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0C9.548 2.336 8.638 3.32 8.638 4.5v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    }
                    @if (canEditExpense || (isExpenseSheetCreateMode && canCreateExpense))
                    {
                        <button id="expenseCancelBtn" type="button" class="topbar-btn pointer-events-auto topbar-hidden"
                                aria-label="@SR["Common_Cancel"]"
                                data-ind-dispatch="expense-detail-cancel-edit"
                                style="padding:0;">
                            <svg id="expenseCancelIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            }
            else if (isExpenseSheetLineDetail && (canEditExpense || canDeleteExpense || (isExpenseSheetLineCreateMode && canCreateExpense)))
            {
                <div class="flex items-center gap-1 pr-1">
                    @if (canEditExpense || (isExpenseSheetLineCreateMode && canCreateExpense))
                    {
                        <button id="expenseLineEditBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_EditSave"]"
                                data-ind-dispatch="expense-line-detail-edit">
                            <svg id="expenseLineEditIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                            </svg>
                            <svg id="expenseLineSaveIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </button>
                    }
                    @if (!isExpenseSheetLineCreateMode && canDeleteExpense)
                    {
                        <button id="expenseLineDeleteBtn" type="button" class="topbar-btn pointer-events-auto"
                                aria-label="@SR["Topbar_Delete"]"
                                data-ind-dispatch="expense-line-detail-delete">
                            <svg id="expenseLineDeleteIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084A2.25 2.25 0 0 1 5.84 19.673L4.772 5.79m14.456 0a48.11 48.11 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.111 48.111 0 0 1 3.478-.397m7.5 0V4.5c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0C9.548 2.336 8.638 3.32 8.638 4.5v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    }
                    @if (canEditExpense || (isExpenseSheetLineCreateMode && canCreateExpense))
                    {
                        <button id="expenseLineCancelBtn" type="button" class="topbar-btn pointer-events-auto topbar-hidden"
                                aria-label="@SR["Common_Cancel"]"
                                data-ind-dispatch="expense-line-detail-cancel-edit"
                                style="padding:0;">
                            <svg id="expenseLineCancelIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            }
            else if (!hideForwardArrow)
            {
                <button id="globalForwardBtn" type="button" class="topbar-btn pointer-events-auto"
                        aria-label="@SR["Topbar_Forward"]" disabled>
                    <svg id="globalForwardIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                    <svg id="globalCreateIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                </button>
            }
        </div>

    </div>
