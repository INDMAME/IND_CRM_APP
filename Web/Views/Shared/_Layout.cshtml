@using IND_CRM_APP.Infrastructure.Localization
@using IND_CRM_APP.Models.Shared
@using IND_CRM_APP.Infrastructure.Security.Modules
@using IND_CRM_APP.Infrastructure.Security.Auth
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Localization.IStringLocalizer<INDSharedResource> SR

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    @{
        var csrfTokens = Antiforgery.GetAndStoreTokens(Context);
    }
    <meta name="csrf-token" content="@csrfTokens.RequestToken" />

    <title>@ViewData["Title"] - IND CRM</title>

    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind local build -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Layout CSS -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />


    @RenderSection("Styles", required: false)
</head>

@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var hideChrome = ViewData["HideChrome"] as bool? ?? false;
    var contentClassOverride = ViewData["ContentClass"] as string;
    var contentClass = string.IsNullOrWhiteSpace(contentClassOverride)
        ? "content w-full max-w-5xl mx-auto px-4 md:px-6"
        : contentClassOverride!;
    var chromeLayoutClass = hideChrome ? "layout-shell--without-chrome" : "layout-shell--with-chrome";

    IndWebContext? permissionContext = null;
    var contextRaw = Context?.Session?.GetString("INDWebContext");
    if (!string.IsNullOrWhiteSpace(contextRaw))
    {
        try
        {
            permissionContext = JsonSerializer.Deserialize<IndWebContext>(contextRaw);
        }
        catch
        {
            permissionContext = null;
        }
    }

    var selectedCompanyId = Context?.Session?.GetString("INDCompanySelected");
    var companySelectionSource = Context?.Session?.GetString("INDCompanySelectionSource");
    if (string.IsNullOrWhiteSpace(selectedCompanyId) &&
        !string.Equals(companySelectionSource, "user", StringComparison.OrdinalIgnoreCase))
    {
        selectedCompanyId = permissionContext?.Header?.DefaultCompany;
    }
    var selectedCompany = !string.IsNullOrWhiteSpace(selectedCompanyId)
        ? permissionContext?.Companies.FirstOrDefault(c => string.Equals(c.CompanyId, selectedCompanyId, StringComparison.OrdinalIgnoreCase))
        : permissionContext?.Companies.FirstOrDefault();

    var claimEntraOid = Context?.User?.FindFirst(IndAuthEnv.ClaimOid)?.Value
        ?? Context?.User?.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
    var sessionEntraOid = Context?.Session?.GetString("ENTRAOID");
    var contextEntraOid = permissionContext?.EntraOid;
    var entraOid = string.Empty;
    if (Context?.User?.Identity?.IsAuthenticated == true)
    {
        if (!string.IsNullOrWhiteSpace(claimEntraOid) &&
            (string.IsNullOrWhiteSpace(contextEntraOid) ||
             string.Equals(claimEntraOid, contextEntraOid, StringComparison.OrdinalIgnoreCase)))
        {
            entraOid = claimEntraOid.Trim();
        }
        else if (string.IsNullOrWhiteSpace(claimEntraOid) &&
                 !string.IsNullOrWhiteSpace(sessionEntraOid) &&
                 !string.IsNullOrWhiteSpace(contextEntraOid) &&
                 string.Equals(sessionEntraOid, contextEntraOid, StringComparison.OrdinalIgnoreCase))
        {
            entraOid = sessionEntraOid.Trim();
        }
    }

    var moduleAccess = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    if (selectedCompany?.Modules != null)
    {
        foreach (var mod in selectedCompany.Modules)
        {
            if (string.IsNullOrWhiteSpace(mod.ModuleCode))
                continue;

            if (!moduleAccess.ContainsKey(mod.ModuleCode))
                moduleAccess[mod.ModuleCode] = mod.AccessRightsInt;

            if (INDModuleRegistry.TryGetCanonicalModuleCode(mod.ModuleCode, out var canonical))
            {
                if (!moduleAccess.ContainsKey(canonical) || moduleAccess[canonical] < mod.AccessRightsInt)
                    moduleAccess[canonical] = mod.AccessRightsInt;
            }
        }
    }

    var moduleAccessJson = JsonSerializer.Serialize(moduleAccess);
    var allowSelfManagement = selectedCompany?.AllowSelfManagement == true;
    var permissionRedirectMessage = TempData?["IndPermissionRedirectMessage"] as string;
    var redirectModalTitle = TempData?["IndRedirectModalTitle"] as string;
    var redirectModalMessage = TempData?["IndRedirectModalMessage"] as string;
    var cspNonce = Context?.Items["CspNonce"]?.ToString() ?? string.Empty;
}
<body class="bg-slate-100 font-sans text-[#00296be0] overflow-x-hidden @chromeLayoutClass @bodyClass">
    <svg class="ind-spinner-defs" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="indSpinnerGradient">
                <stop offset="0%" stop-color="currentColor" stop-opacity="1" />
                <stop offset="100%" stop-color="currentColor" stop-opacity="0.25" />
            </linearGradient>
        </defs>
    </svg>

    <div id="indGlobalLoading" class="ind-global-loading" role="status" aria-live="polite" aria-hidden="false">
        <div class="ind-global-loading__panel">
            <svg class="ind-spinner h-12 w-12" viewBox="0 0 20 20" aria-hidden="true">
                <circle class="ind-spinner__circle" cx="10" cy="10" r="8" stroke-width="2"></circle>
            </svg>
            <span class="ind-global-loading__text" data-ind-loading-text>@SR["Common_Loading"].Value</span>
        </div>
    </div>

    @if (!hideChrome)
    {
        <!-- TOPBAR -->
        @await Html.PartialAsync("_Topbar")

        <!-- OVERLAY -->
        <div id="overlay" class="overlay fixed inset-0 bg-black/45 opacity-0 pointer-events-none transition duration-200" aria-hidden="true"></div>

        <!-- SIDEBAR -->
        @await Html.PartialAsync("_Sidebar")
    }

    <div id="content" class="@contentClass">
        @RenderBody()
    </div>

    <div id="indPermissionModal" class="fixed inset-0 z-600000 hidden items-center justify-center bg-black/40 backdrop-blur-[1px] px-4" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="w-full max-w-sm rounded-2xl bg-white shadow-xl border border-slate-200 p-5 space-y-4">
            <div id="indPermissionModalTitle" class="text-lg font-semibold text-slate-900">@SR["Auth_PermissionDenied_Title"]</div>
            <div id="indPermissionModalBody" class="text-sm text-slate-700 whitespace-pre-line">@SR["Auth_PermissionDenied_Body"]</div>
            <div class="flex justify-end pt-2">
                <button id="indPermissionModalOk" type="button" class="px-4 py-2 rounded-xl bg-primary text-white hover:bg-primary/90 transition">
                    @SR["Common_OK"]
                </button>
            </div>
        </div>
    </div>

    <div id="indNavGuardModal" class="fixed inset-0 z-600000 hidden items-center justify-center bg-black/40 backdrop-blur-[1px] px-4" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="w-full max-w-sm rounded-2xl bg-white shadow-xl border border-slate-200 p-5 space-y-4">
            <div id="indNavGuardModalBody" class="text-sm text-slate-700 whitespace-pre-line"></div>
            <div class="flex justify-end gap-2 pt-2">
                <button id="indNavGuardModalCancel" type="button" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 hover:border-primary hover:text-primary transition">
                    @SR["Confirm_No"]
                </button>
                <button id="indNavGuardModalConfirm" type="button" class="px-4 py-2 rounded-xl bg-primary text-white hover:bg-primary/90 transition">
                    @SR["Confirm_Yes"]
                </button>
            </div>
        </div>
    </div>

    @if (!hideChrome)
    {
        <script nonce="@cspNonce">
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("overlay");
            const content = document.getElementById("content");
            const btnMenu = document.getElementById("btnMenu");
            const topbar = document.querySelector(".topbar");
            const topbarLeft = document.querySelector(".topbar-left");
            const topbarRight = document.querySelector(".topbar-right");
            const topbarTitle = document.getElementById("topbarTitle");
            const sidebarCloseBtn = document.getElementById("sidebarCloseBtn");
            const userMenuToggle = document.getElementById("userMenuToggle");
            const langBtn = document.getElementById("indLangButton");
            const backBtn = document.getElementById("globalBackBtn");
            const dispatchButtons = document.querySelectorAll("[data-ind-dispatch]");
            const companySub = document.getElementById("indCompanySubmenu");
            const companyBtn = document.getElementById("indCompanyButton");

            let menuOpen = false;
            let touchStartX = 0;
            let touchStartY = 0;
            let touchTracking = false;

            setSidebarHidden(true);
            overlay?.setAttribute("aria-hidden", "true");

            function updateTopbarTitleLayout() {
                if (!topbarTitle) return;
                if (!topbarTitle.classList.contains("topbar-title--with-company")) {
                    topbarTitle.classList.remove("topbar-title--stacked");
                    return;
                }
                if (!topbar) return;

                const titleMain = topbarTitle.querySelector(".topbar-title__main");
                const titleCompany = topbarTitle.querySelector(".topbar-title__company");
                if (!titleMain || !titleCompany) return;

                topbarTitle.classList.remove("topbar-title--stacked");

                const leftWidth = topbarLeft ? topbarLeft.getBoundingClientRect().width : 0;
                const rightWidth = topbarRight ? topbarRight.getBoundingClientRect().width : 0;
                const availableWidth = Math.max(0, topbar.getBoundingClientRect().width - leftWidth - rightWidth - 28);
                const requiredWidth = titleMain.getBoundingClientRect().width + titleCompany.getBoundingClientRect().width + 8;

                if (requiredWidth > availableWidth) {
                    topbarTitle.classList.add("topbar-title--stacked");
                }
            }

            function updateSidebarHeight() {
                if (!sidebar) return;
                const doc = document.documentElement;
                const body = document.body;
                const pageHeight = Math.max(
                    body.scrollHeight,
                    doc.scrollHeight,
                    body.offsetHeight,
                    doc.offsetHeight
                );
                const viewportHeight = window.innerHeight || doc.clientHeight || 0;
                const isTallPage = pageHeight > viewportHeight + 24;
                sidebar.classList.toggle("sidebar--tall", isTallPage);
                const targetHeight = isTallPage ? pageHeight : viewportHeight;
                sidebar.style.setProperty("--sidebar-height", `${Math.round(targetHeight)}px`);
            }

            // Keeps the hidden sidebar out of both the accessibility tree and tab order.
            function setSidebarHidden(isHidden) {
                if (!sidebar) return;
                if (isHidden) {
                    moveFocusOutOfSidebar();
                    sidebar.setAttribute("inert", "");
                    sidebar.setAttribute("aria-hidden", "true");
                } else {
                    sidebar.removeAttribute("inert");
                    sidebar.setAttribute("aria-hidden", "false");
                }
            }

            // Moves focus to the menu opener before the sidebar is hidden.
            function moveFocusOutOfSidebar() {
                if (!sidebar || !btnMenu) return;
                const activeElement = document.activeElement;
                if (activeElement instanceof HTMLElement && sidebar.contains(activeElement)) {
                    btnMenu.focus({ preventScroll: true });
                }
            }

            // Closes nested account menus so reopening the sidebar starts from a stable state.
            function closeUserMenuPanels() {
                const menu = document.getElementById("userMenu");
                const chevron = document.getElementById("userMenuChevron");
                const langSub = document.getElementById("indLangSubmenu");
                const userChip = document.querySelector(".user-chip");

                menu?.classList.remove("open");
                chevron?.classList.remove("rotate-180");
                langSub?.classList.add("hidden");
                langBtn?.setAttribute("aria-expanded", "false");
                companySub?.classList.add("hidden");
                companyBtn?.setAttribute("aria-expanded", "false");
                userChip?.setAttribute("aria-expanded", "false");
            }

            const toggleSidebar = () => {
                if (!sidebar || !overlay || !content || !btnMenu || !topbar) return;

                menuOpen = !menuOpen;

                if (menuOpen) {
                    sidebar.classList.add("open");
                    sidebar.classList.add("sidebar--dock-user");
                    overlay.classList.add("visible");
                    setSidebarHidden(false);
                    overlay.setAttribute("aria-hidden", "false");
                    btnMenu.style.opacity = "0";
                    btnMenu.style.pointerEvents = "none";
                    btnMenu.setAttribute("aria-expanded", "true");

                    if (window.innerWidth > 768) {
                        content.classList.add("shifted");
                        topbar.classList.add("shifted");
                    }
                    updateSidebarHeight();
                    updateTopbarTitleLayout();
                } else {
                    sidebar.classList.remove("open");
                    sidebar.classList.remove("sidebar--dock-user");
                    overlay.classList.remove("visible");
                    btnMenu.style.opacity = "1";
                    btnMenu.style.pointerEvents = "auto";
                    btnMenu.setAttribute("aria-expanded", "false");
                    moveFocusOutOfSidebar();
                    closeUserMenuPanels();
                    setSidebarHidden(true);
                    overlay.setAttribute("aria-hidden", "true");
                    content.classList.remove("shifted");
                    topbar.classList.remove("shifted");
                    updateTopbarTitleLayout();
                }
            };

            function shouldIgnoreOutsidePress(target) {
                if (!target) return false;
                if (sidebar && sidebar.contains(target)) return true;
                if (btnMenu && btnMenu.contains(target)) return true;
                return false;
            }

            function handleOutsidePress(event) {
                if (!menuOpen) return;
                if (shouldIgnoreOutsidePress(event.target)) return;
                toggleSidebar();
            }

            function handleSwipeStart(event) {
                if (!menuOpen) return;
                const touch = event.touches && event.touches[0];
                if (!touch) return;
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                touchTracking = true;
            }

            function handleSwipeMove(event) {
                if (!menuOpen || !touchTracking) return;
                const touch = event.touches && event.touches[0];
                if (!touch) return;
                const deltaX = touch.clientX - touchStartX;
                const deltaY = touch.clientY - touchStartY;
                if (deltaX < -40 && Math.abs(deltaX) > Math.abs(deltaY) + 6) {
                    touchTracking = false;
                    toggleSidebar();
                }
            }

            function handleSwipeEnd() {
                touchTracking = false;
            }

            function toggleUserMenu() {
                const menu = document.getElementById("userMenu");
                const chevron = document.getElementById("userMenuChevron");
                if (!menu) return;

                const isOpen = menu.classList.toggle("open");
                if (chevron) {
                    chevron.classList.toggle("rotate-180", isOpen);
                }

                if (!isOpen) {
                    closeUserMenuPanels();
                    return;
                }
                const userChip = document.querySelector(".user-chip");
                if (userChip) {
                    userChip.setAttribute("aria-expanded", isOpen.toString());
                }
            }

            function toggleIndLanguageMenu() {
                const langSub = document.getElementById("indLangSubmenu");
                const langBtn = document.getElementById("indLangButton");
                if (!langSub || !langBtn) return;

                const nowHidden = langSub.classList.toggle("hidden");
                langBtn.setAttribute("aria-expanded", (!nowHidden).toString());
            }

            function toggleIndCompanyMenu() {
                if (!companySub || !companyBtn) return;
                const nowHidden = companySub.classList.toggle("hidden");
                companyBtn.setAttribute("aria-expanded", (!nowHidden).toString());
            }

            // Post company selection with fetch so we can use location.replace.
            function bindCompanyForms() {
                const forms = document.querySelectorAll(".ind-company-form");
                if (!forms.length) return;

                forms.forEach((form) => {
                    if (form.dataset.indBound === "true") return;
                    form.dataset.indBound = "true";
                    form.addEventListener("submit", (event) => {
                        event.preventDefault();
                        const browserState = window.IND && window.IND.browserState;
                        browserState?.prepareForCompanyChange?.();
                        const payload = new FormData(form);
                        fetch(form.action, {
                            method: "POST",
                            body: payload,
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        })
                            .then((res) => {
                                if (!res.ok) throw new Error("Company change failed.");
                                if (typeof window.__indBypassNavigationGuardOnce === "function") {
                                    window.__indBypassNavigationGuardOnce();
                                }
                                browserState?.completeCompanyChange?.();
                                window.location.replace("/");
                            })
                            .catch(() => {
                                if (typeof window.__indBypassNavigationGuardOnce === "function") {
                                    window.__indBypassNavigationGuardOnce();
                                }
                                if (browserState && typeof browserState.completeCompanyChange === "function") {
                                    browserState.completeCompanyChange();
                                    window.location.replace("/");
                                    return;
                                }
                                HTMLFormElement.prototype.submit.call(form);
                            });
                    });
                });
            }

            const runDefaultBack = () => {
                if (!backBtn || backBtn.getAttribute("data-back-default") !== "true") {
                    return;
                }

                const backUrl = backBtn.getAttribute("data-back-url") || "";
                const executeBackNavigation = () => {
                    if (backUrl) {
                        window.location.href = backUrl;
                        return;
                    }

                    if (typeof window.__indAllowHistoryOnce === "function") {
                        window.__indAllowHistoryOnce();
                        return;
                    }

                    window.history.back();
                };

                if (typeof window.__indRequestNavigation === "function") {
                    window.__indRequestNavigation(executeBackNavigation);
                    return;
                }

                executeBackNavigation();
            };

            const dispatchTopbarEvent = (eventName) => {
                if (!eventName) return;
                window.dispatchEvent(new CustomEvent(eventName));
            };

            const hideModal = (modalId) => {
                if (!modalId) return;
                const modal = document.getElementById(modalId);
                if (!modal) return;
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                modal.setAttribute("aria-hidden", "true");
            };

            const showModal = (modalId) => {
                if (!modalId) return;
                const modal = document.getElementById(modalId);
                if (!modal) return;
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                modal.setAttribute("aria-hidden", "false");
            };

            btnMenu?.addEventListener("click", toggleSidebar);
            sidebarCloseBtn?.addEventListener("click", toggleSidebar);
            userMenuToggle?.addEventListener("click", toggleUserMenu);
            langBtn?.addEventListener("click", toggleIndLanguageMenu);
            companyBtn?.addEventListener("click", toggleIndCompanyMenu);
            backBtn?.addEventListener("click", runDefaultBack);
            dispatchButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    dispatchTopbarEvent(button.getAttribute("data-ind-dispatch"));
                });
            });

            // Backward compatibility for existing scripts that still call these helpers.
            window.toggleSidebar = toggleSidebar;
            window.hideModal = hideModal;
            window.showModal = showModal;

            updateSidebarHeight();
            updateTopbarTitleLayout();
            bindCompanyForms();
            window.addEventListener("resize", updateSidebarHeight);
            window.addEventListener("resize", updateTopbarTitleLayout);
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(updateTopbarTitleLayout).catch(() => { });
            }
            document.addEventListener("pointerdown", handleOutsidePress, true);
            sidebar?.addEventListener("touchstart", handleSwipeStart, { passive: true });
            sidebar?.addEventListener("touchmove", handleSwipeMove, { passive: true });
            sidebar?.addEventListener("touchend", handleSwipeEnd, { passive: true });
            sidebar?.addEventListener("touchcancel", handleSwipeEnd, { passive: true });
            overlay?.addEventListener("touchstart", handleSwipeStart, { passive: true });
            overlay?.addEventListener("touchmove", handleSwipeMove, { passive: true });
            overlay?.addEventListener("touchend", handleSwipeEnd, { passive: true });
            overlay?.addEventListener("touchcancel", handleSwipeEnd, { passive: true });
        </script>
    }

    <script nonce="@cspNonce">
        (function () {
            const hideModal = function (modalId) {
                if (!modalId) return;
                const modal = document.getElementById(modalId);
                if (!modal) return;
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                modal.setAttribute("aria-hidden", "true");
            };

            const showModal = function (modalId) {
                if (!modalId) return;
                const modal = document.getElementById(modalId);
                if (!modal) return;
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                modal.setAttribute("aria-hidden", "false");
            };

            if (typeof window.hideModal !== "function") {
                window.hideModal = hideModal;
            }
            if (typeof window.showModal !== "function") {
                window.showModal = showModal;
            }

            if (window.__indModalCloseBound === true) {
                return;
            }

            document.addEventListener("click", function (event) {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const closeBtn = target.closest("[data-ind-modal-close]");
                if (!closeBtn) return;
                window.hideModal(closeBtn.getAttribute("data-ind-modal-close"));
            });

            window.__indModalCloseBound = true;
        })();
    </script>

    @{
        try
        {
            await Html.PartialAsync("_IndActionMark");
        }
        catch
        {
            // Defensive: do not break pages if the partial is missing.
        }
    }

    <script nonce="@cspNonce" src="~/js/ind-action-mark.js" asp-append-version="true"></script>


    <script nonce="@cspNonce">
        window.__IND_MODULE_ACCESS__ = @Html.Raw(moduleAccessJson);
        window.__IND_ENTRA_OID__ = @Html.Raw(JsonSerializer.Serialize(entraOid));
        window.__IND_SELECTED_COMPANY__ = @Html.Raw(JsonSerializer.Serialize(selectedCompanyId ?? string.Empty));
        window.__IND_ALLOW_SELF_MANAGEMENT__ = @Html.Raw(JsonSerializer.Serialize(allowSelfManagement));
        window.__IND_PERMISSION_I18N__ = {
            title: @Html.Raw(JsonSerializer.Serialize(SR["Auth_PermissionDenied_Title"].Value)),
            message: @Html.Raw(JsonSerializer.Serialize(SR["Auth_PermissionDenied_Body"].Value)),
            ok: @Html.Raw(JsonSerializer.Serialize(SR["Common_OK"].Value))
        };
        window.__IND_NAV_GUARD_I18N__ = {
            activeProcessMessage: @Html.Raw(JsonSerializer.Serialize(SR["Navigation_ActiveProcess_ConfirmLeave"].Value)),
            confirm: @Html.Raw(JsonSerializer.Serialize(SR["Confirm_Yes"].Value)),
            cancel: @Html.Raw(JsonSerializer.Serialize(SR["Confirm_No"].Value))
        };
    </script>

    <script nonce="@cspNonce" src="~/js/ind-browser-state.js" asp-append-version="true"></script>

    <script nonce="@cspNonce">
        (function () {
            const i18n = window.__IND_NAV_GUARD_I18N__ || {};
            const defaultMessage =
                (typeof i18n.activeProcessMessage === "string" && i18n.activeProcessMessage.trim()) ||
                "Your active process will be canceled and unsaved changes will be lost. Do you want to continue?";
            const defaultConfirmText =
                (typeof i18n.confirm === "string" && i18n.confirm.trim()) || "OK";
            const defaultCancelText =
                (typeof i18n.cancel === "string" && i18n.cancel.trim()) || "Cancel";

            const modal = document.getElementById("indNavGuardModal");
            const modalBody = document.getElementById("indNavGuardModalBody");
            const modalConfirmBtn = document.getElementById("indNavGuardModalConfirm");
            const modalCancelBtn = document.getElementById("indNavGuardModalCancel");

            const guard = {
                active: false,
                message: defaultMessage,
                block: false,
                bypass: false,
                resetTimer: 0,
                pendingAction: null,
                modalOpen: false
            };
            let previousFocusedElement = null;

            const clearBypassTimer = () => {
                if (!guard.resetTimer) return;
                window.clearTimeout(guard.resetTimer);
                guard.resetTimer = 0;
            };

            const bypassOnce = () => {
                clearBypassTimer();
                guard.bypass = true;
                guard.resetTimer = window.setTimeout(() => {
                    guard.bypass = false;
                    guard.resetTimer = 0;
                }, 250);
            };

            const resolveMessage = (candidate) =>
                (typeof candidate === "string" && candidate.trim()) ? candidate : defaultMessage;

            const setGuard = (activeOrOptions, message) => {
                if (typeof activeOrOptions === "object" && activeOrOptions !== null) {
                    guard.active = !!activeOrOptions.active;
                    guard.message = resolveMessage(activeOrOptions.message);
                    guard.block = !!activeOrOptions.block;
                    return;
                }
                guard.active = !!activeOrOptions;
                guard.message = resolveMessage(message);
                guard.block = false;
            };

            const clearGuard = () => {
                guard.active = false;
                guard.message = defaultMessage;
                guard.block = false;
                guard.pendingAction = null;
                if (guard.modalOpen && modal) {
                    if (modal.contains(document.activeElement)) {
                        document.activeElement.blur?.();
                    }
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                    modal.setAttribute("aria-hidden", "true");
                    guard.modalOpen = false;
                    if (previousFocusedElement && document.contains(previousFocusedElement)) {
                        window.requestAnimationFrame(() => previousFocusedElement.focus?.({ preventScroll: true }));
                    }
                    previousFocusedElement = null;
                }
            };

            const closeModal = () => {
                guard.pendingAction = null;
                if (!modal || !guard.modalOpen) return;
                if (modal.contains(document.activeElement)) {
                    document.activeElement.blur?.();
                }
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                modal.setAttribute("aria-hidden", "true");
                guard.modalOpen = false;
                if (previousFocusedElement && document.contains(previousFocusedElement)) {
                    window.requestAnimationFrame(() => previousFocusedElement.focus?.({ preventScroll: true }));
                }
                previousFocusedElement = null;
            };

            const executeAction = (action) => {
                if (typeof action !== "function") return;
                bypassOnce();
                action();
            };

            const openModal = (message, action) => {
                guard.pendingAction = typeof action === "function" ? action : null;
                const safeMessage = resolveMessage(message);

                if (!modal || !modalBody || !modalConfirmBtn || !modalCancelBtn) {
                    if (window.confirm(safeMessage)) {
                        executeAction(guard.pendingAction);
                    } else {
                        guard.pendingAction = null;
                    }
                    return;
                }

                previousFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
                modalBody.textContent = safeMessage;
                modalConfirmBtn.textContent = defaultConfirmText;
                modalCancelBtn.textContent = defaultCancelText;
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                modal.setAttribute("aria-hidden", "false");
                guard.modalOpen = true;
                window.requestAnimationFrame(() => modalConfirmBtn.focus());
            };

            const requestNavigation = (action, message) => {
                if (guard.bypass || !guard.active) {
                    executeAction(action);
                    return true;
                }
                if (guard.block) {
                    return false;
                }
                openModal(message || guard.message, action);
                return false;
            };

            const confirmNavigation = () => {
                return !guard.active || guard.bypass;
            };

            const isSameDocumentHashNavigation = (url) =>
                url.origin === window.location.origin &&
                url.pathname === window.location.pathname &&
                url.search === window.location.search &&
                !!url.hash;

            const shouldHandleAnchorClick = (anchor, event) => {
                if (!anchor) return false;
                if (anchor.hasAttribute("data-no-nav-guard")) return false;
                if (anchor.hasAttribute("download")) return false;
                if (anchor.target && anchor.target !== "_self") return false;
                if (event.defaultPrevented) return false;
                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
                if (typeof event.button === "number" && event.button !== 0) return false;

                const rawHref = anchor.getAttribute("href");
                if (!rawHref) return false;

                const href = String(rawHref).trim();
                if (!href || href.startsWith("#") || href.startsWith("javascript:")) return false;
                if (href.startsWith("mailto:") || href.startsWith("tel:")) return false;

                try {
                    const url = new URL(href, window.location.href);
                    if (isSameDocumentHashNavigation(url)) return false;
                } catch {
                    return false;
                }

                return true;
            };

            const onDocumentClick = (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const anchor = target.closest("a[href]");
                if (!shouldHandleAnchorClick(anchor, event)) return;
                if (!guard.active || guard.bypass) return;

                const href = anchor.href;
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation?.();

                requestNavigation(() => {
                    window.location.assign(href);
                });
            };

            const onDocumentSubmit = (event) => {
                const target = event.target;
                if (!(target instanceof HTMLFormElement)) return;
                if (target.hasAttribute("data-no-nav-guard")) return;
                if (target.target && target.target !== "_self") return;
                if (event.defaultPrevented) return;

                const form = target;
                const submitForm = () => {
                    const browserState = window.IND && window.IND.browserState;
                    if (form.hasAttribute("data-ind-browser-state-logout")) {
                        if (browserState && typeof browserState.submitLogoutForm === "function") {
                            void browserState.submitLogoutForm(form);
                            return;
                        }
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }
                    if (typeof form.requestSubmit === "function") {
                        form.requestSubmit();
                        return;
                    }
                    form.submit();
                };

                if (!guard.active || guard.bypass) {
                    if (!form.hasAttribute("data-ind-browser-state-logout")) return;
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation?.();
                    submitForm();
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation?.();
                requestNavigation(submitForm);
            };

            const onBeforeUnload = (event) => {
                if (!guard.active || guard.bypass) return;
                event.preventDefault();
                event.returnValue = "";
            };

            const onModalConfirm = () => {
                const action = guard.pendingAction;
                closeModal();
                executeAction(action);
            };

            const onModalCancel = () => {
                closeModal();
            };

            modalConfirmBtn?.addEventListener("click", onModalConfirm);
            modalCancelBtn?.addEventListener("click", onModalCancel);
            modal?.addEventListener("click", (event) => {
                if (event.target === modal) {
                    onModalCancel();
                }
            });
            document.addEventListener("keydown", (event) => {
                if (!guard.modalOpen) return;
                if (event.key === "Escape") {
                    event.preventDefault();
                    onModalCancel();
                }
            });

            window.__indSetNavigationGuard = setGuard;
            window.__indClearNavigationGuard = clearGuard;
            window.__indBypassNavigationGuardOnce = bypassOnce;
            window.__indConfirmNavigation = confirmNavigation;
            window.__indRequestNavigation = requestNavigation;

            document.addEventListener("click", onDocumentClick, true);
            document.addEventListener("submit", onDocumentSubmit, true);
            window.addEventListener("beforeunload", onBeforeUnload);
        })();
    </script>

    @{
        try
        {
            await Html.PartialAsync("_IndActionMarkInit");
        }
        catch
        {
            // Defensive: do not break pages if the partial is missing.
        }
    }

    <script nonce="@cspNonce">
        (function () {
            // Block swipe back/forward by trapping history entries.
            const trapState = { indTrap: true };

            function pushTrap() {
                try {
                    history.pushState(trapState, "", location.href);
                } catch {
                    // ignore
                }
            }

            function ensureTrap() {
                try {
                    if (!history.state || history.state.indTrap !== true) {
                        pushTrap();
                    }
                } catch {
                    pushTrap();
                }
            }

            window.__indNavigateBack = function (fallbackUrl) {
                const run = function () {
                    try {
                        if (history.state && history.state.indTrap === true) {
                            history.go(-2);
                            return;
                        }
                    } catch {
                        // ignore
                    }
                    if (fallbackUrl) {
                        window.location.href = fallbackUrl;
                        return;
                    }
                    try {
                        history.back();
                    } catch {
                        if (fallbackUrl) {
                            window.location.href = fallbackUrl;
                        }
                    }
                };

                if (typeof window.__indRequestNavigation === "function") {
                    window.__indRequestNavigation(run);
                    return;
                }
                run();
            };

            // Backward compatibility alias.
            window.__indAllowHistoryOnce = window.__indNavigateBack;

            ensureTrap();
            window.addEventListener("popstate", function () {
                ensureTrap();
            });
        })();
    </script>

    <script nonce="@cspNonce">
        (function () {
            const overlay = document.getElementById("indGlobalLoading");
            if (!overlay) return;

            const label = overlay.querySelector("[data-ind-loading-text]");
            let activeCount = 0;

            const showOverlay = (message) => {
                if (message && label) {
                    label.textContent = String(message);
                }
                overlay.classList.remove("ind-global-loading--hidden");
                overlay.setAttribute("aria-hidden", "false");
            };

            const hideOverlay = () => {
                overlay.classList.add("ind-global-loading--hidden");
                overlay.setAttribute("aria-hidden", "true");
            };

            // Global helpers for cache-heavy flows or long-running actions.
            window.__indShowGlobalSpinner = function (message) {
                activeCount += 1;
                showOverlay(message);
            };

            window.__indHideGlobalSpinner = function () {
                activeCount = Math.max(0, activeCount - 1);
                if (activeCount === 0) {
                    hideOverlay();
                }
            };

            if (document.readyState === "complete") {
                hideOverlay();
                return;
            }

            window.addEventListener("load", function () {
                hideOverlay();
            }, { once: true });
        })();
    </script>

    <script nonce="@cspNonce">
        (function () {
            const modal = document.getElementById("indPermissionModal");
            if (!modal) return;
            const titleEl = document.getElementById("indPermissionModalTitle");
            const bodyEl = document.getElementById("indPermissionModalBody");
            const okBtn = document.getElementById("indPermissionModalOk");
            const i18n = window.__IND_PERMISSION_I18N__ || {};

            const hide = () => {
                modal.classList.add("hidden");
                modal.setAttribute("aria-hidden", "true");
            };

            const show = (opts) => {
                const title = opts && typeof opts.title === "string" && opts.title.trim() ? opts.title : i18n.title;
                const message = opts && typeof opts.message === "string" && opts.message.trim() ? opts.message : i18n.message;
                if (titleEl && title) titleEl.textContent = title;
                if (bodyEl && message) bodyEl.textContent = message;
                if (okBtn && i18n.ok) okBtn.textContent = i18n.ok;
                modal.classList.remove("hidden");
                modal.setAttribute("aria-hidden", "false");
            };

            okBtn?.addEventListener("click", hide);
            modal.addEventListener("click", (event) => {
                if (event.target === modal) hide();
            });

            window.IND = window.IND || {};
            window.IND.showPermissionModal = show;
            window.IND.hidePermissionModal = hide;
        })();
    </script>

    @if (!string.IsNullOrWhiteSpace(permissionRedirectMessage) || !string.IsNullOrWhiteSpace(redirectModalMessage))
    {
        <script nonce="@cspNonce">
            (function () {
                const title = @Html.Raw(JsonSerializer.Serialize(redirectModalTitle));
                const message = @Html.Raw(JsonSerializer.Serialize(redirectModalMessage ?? permissionRedirectMessage));
                if (window.IND && typeof window.IND.showPermissionModal === "function") {
                    window.IND.showPermissionModal({ title: title, message: message });
                }
            })();
        </script>
    }

    @RenderSection("Scripts", required: false)
