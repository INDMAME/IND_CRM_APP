var verified = 0;
foreach (var legacy in new[] { false, true })
{
    foreach (var metadata in new[] { false, true })
    {
        var scenario = Create();
        scenario.Api.Deletion.Response.Data!.MetadataAvailable = metadata;
        var json = Check(await Delete(scenario.Controller, legacy), 200, legacy, true);
        Require(json.GetProperty(legacy ? "data" : "Data").GetProperty("MetadataAvailable").GetBoolean() == metadata, "Origin metadata was changed");
        Require(scenario.Api.Calls.SequenceEqual(new[] { "GetExpenseSheetDeletionAsync", "GetExpenseSheetDetailAsync", "DeleteExpenseSheetWithTicketsAsync" }), "Initial deletion must validate first and never pre-detach assets");
        verified++;
    }

    var retry = Create();
    retry.Api.Progress.Response.Data = new() { Exists = true, SheetDeleted = true };
    retry.Api.Deletion = Transport(409, false, new() { Exists = true, SheetDeleted = true }, "CRM_EXPENSESHEET_CLEANUP_PENDING");
    var pending = Check(await Delete(retry.Controller, legacy), 409, legacy, false);
    Require(pending.GetProperty(legacy ? "errorCode" : "ErrorCode").GetString() == "CRM_EXPENSESHEET_CLEANUP_PENDING", "Pending cleanup lost error code");
    Require(!retry.Controller.TempData.ContainsKey("IND_ActionMark_Type"), "Pending cleanup must not show delete success");
    retry.Api.Deletion = Transport(200, true, new() { Exists = true, SheetDeleted = true, Complete = true });
    Check(await Delete(retry.Controller, legacy), 200, legacy, true);
    Require(!retry.Api.Calls.Contains("GetExpenseSheetDetailAsync"), "Cleanup retry must not require a deleted header");
    Require(retry.Api.Calls.Count(name => name == "DeleteExpenseSheetWithTicketsAsync") == 2, "Cleanup retry was not forwarded");
    verified++;

    var lostCommit = Create();
    lostCommit.Api.Progress.Response.Data = new() { Exists = true, DeleteAttempted = true };
    Check(await Delete(lostCommit.Controller, legacy), 200, legacy, true);
    Require(!lostCommit.Api.Calls.Contains("GetExpenseSheetDetailAsync"), "A lost commit response must be reconciled by the authorized durable operation");
    verified++;

    var deniedJournal = Create();
    deniedJournal.Api.Progress = Transport(403, false, null, "AUTH_FORBIDDEN");
    Check(await Delete(deniedJournal.Controller, legacy), 403, legacy, false);
    Require(deniedJournal.Api.Calls.SequenceEqual(new[] { "GetExpenseSheetDeletionAsync" }), "Denied progress must stop deletion");
    verified++;

    var deniedDelete = Create();
    deniedDelete.Api.Deletion = Transport(403, false, null, "AUTH_FORBIDDEN");
    Check(await Delete(deniedDelete.Controller, legacy), 403, legacy, false);
    Require(!deniedDelete.Controller.TempData.ContainsKey("IND_ActionMark_Type"), "Rejected deletion must not show success");
    verified++;

    var deniedActor = Create();
    deniedActor.Controller.Request.Headers["X-IND-AxUserId"] = "OUTSIDE";
    Check(await Delete(deniedActor.Controller, legacy), 403, legacy, false);
    Require(deniedActor.Api.Calls.SequenceEqual(new[] { "GetExpenseSheetSubordinatesAsync" }), "Unvalidated actor reached durable endpoints");
    verified++;

    var deniedOwner = Create();
    deniedOwner.Api.Sheet.OwnerAxUserId = "OTHER";
    deniedOwner.Api.Sheet.UserId = "OTHER";
    Check(await Delete(deniedOwner.Controller, legacy), 403, legacy, false);
    Require(!deniedOwner.Api.Calls.Contains("DeleteExpenseSheetWithTicketsAsync"), "Owner guard was bypassed before initial deletion");
    verified++;

    var paid = Create();
    paid.Api.Sheet.ExpenseSheetStatus = 4;
    Check(await Delete(paid.Controller, legacy), 409, legacy, false);
    Require(!paid.Api.Calls.Contains("DeleteExpenseSheetWithTicketsAsync"), "Paid sheet reached delete");
    verified++;

    var malformed = Create();
    malformed.Api.Progress = Transport(200, true, null);
    Check(await Delete(malformed.Controller, legacy), 502, legacy, false);
    Require(!malformed.Api.Calls.Contains("DeleteExpenseSheetWithTicketsAsync"), "Malformed progress permitted deletion");
    verified++;

    var incomplete = Create();
    incomplete.Api.Deletion = Transport(200, true, new() { Exists = true, SheetDeleted = true, Complete = false });
    Check(await Delete(incomplete.Controller, legacy), 409, legacy, false);
    verified++;
}

