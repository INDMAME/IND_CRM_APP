foreach (var (from, to) in new[] { (1, 2), (1, 3), (2, 1), (3, 1) }) {
    var manager = Create();
    manager.Api.Sheet.UserId = "SUB-CRM";
    manager.Api.Sheet.OwnerAxUserId = "SUB-AX";
    manager.Api.Sheet.ExpenseSheetStatus = from;
    manager.Api.Sheet.Description = "Original";
    manager.Api.Sheet.CurrencyCode = "EUR";
    manager.Api.Sheet.ExchRate = 1m;
    manager.Api.Sheet.ProjId = "P-1";
    manager.Api.Sheet.ReimbursableExpense = 1;
    manager.Api.Subordinates = new[] { new ExpenseSheetSubordinateDto { CrmUserId = "SUB-CRM", AxUserId = "SUB-AX" } };
    manager.Controller.Request.Headers["X-IND-AxUserId"] = "SUB-AX";
    Check(await manager.Controller.ApiExpenseSheetUpdate("HG-1", new ExpenseSheetUpdateRequest {
        Description = "Tampered", CurrencyCode = "USD", ExchRate = 99m, ProjId = "P-OTHER", ProjIdProvided = true,
        Voucher = "V-OTHER", ReimbursableExpense = 0, ExpenseSheetStatus = to, EstadoComentarios = "Decision"
    }), 200, false, true);
    var sent = manager.Api.HeaderUpdateArguments!;
    var header = (ExpenseSheetUpdateRequest)sent[2]!;
    Require(header.Description == "Original" && header.CurrencyCode == "EUR" && header.ExchRate == 100m &&
        header.ProjId == null && header.ProjIdProvided == false && header.Voucher == null &&
        header.ReimbursableExpense == 1 && header.ExpenseSheetStatus == to && header.EstadoComentarios == "Decision",
        "Approval changed unrelated header fields: " + JsonSerializer.Serialize(header));
    Require(Equals(sent[3], "SUB-AX") && Equals(sent[4], "OWNER"), "Real approval actor was not forwarded");
    verified++;
}

