        #    axUserId  = conPeek(_data, 2);
        #    fileId    = conPeek(_data, 3);
        #    lineDescr = conPeek(_data, 4);
        #    qty       = conPeek(_data, 5);
        #    price     = conPeek(_data, 6);
        #    lineTotal = qty * price;
        #
        #    if (conLen(_data) >= 7)
        #        lineTotal = conPeek(_data, 7);
