      SOURCE #createExpenseSheetTicketLine
        #// Method: createExpenseSheetTicketLine
        #// Purpose: Creates one granular line for an existing ticket by FileId.
        #// Input:
        #//  - _data[1] = CompanyId
        #//  - _data[2] = axUserId
        #//  - _data[3] = fileId
        #//  - _data[4] = lineDescription
