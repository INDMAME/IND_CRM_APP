        #        return INDCRMUtilityService::buildHeader(false, 'CompanyId es obligatorio.', conNull());
        #
        #    if (conLen(_data) < 6)
        #        return INDCRMUtilityService::buildHeader(false, 'Input container invalido. Se esperan 6 campos obligatorios.', conNull());
