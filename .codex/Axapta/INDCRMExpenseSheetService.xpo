      ENDSOURCE
      SOURCE #createExpenseSheetTicket
        #/*
        #    Metodo: indExpenseSheetTicketCreate (createExpenseSheetTicket)
        #    Proposito:
        #      - Modo 0 (predeterminado): Crea la cabecera del ticket + lineas + metadatos de DocuRef.
        #      - Modo 1: Crea solo la cabecera del ticket + metadatos de DocuRef.
        #      - Modo 2: Anade linea(s) a un ticket existente (por FileId).
        #    Entrada _data (contenedor):
        #      1) companyId
