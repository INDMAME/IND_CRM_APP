      SOURCE #getExpenseSheetTicketsLinkList
        #// Metodo: getExpenseSheetTicketsLinkList
        #// Proposito: Devuelve la lista de tickets vinculables para un usuario.
        #// Entrada:
        #//  - _data[1] = CompanyId
