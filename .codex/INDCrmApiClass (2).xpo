      SOURCE #loginEntraContext
        #// Devuelve el contexto completo para cachearlo en la API.
        #// Entrada:
        #//  - _data[1] = EntraOid
        #//  - _data[2] = AppCode
        #//
        #// Salida: [ Header, Companies ]
        #// Header = [[ success, message, axUserId, userActive, appActive, defaultCompany ]]
        #// Companies = lista de CompanyItem
        #// CompanyItem = [ companyId, isDefault, companyName, modulesCon ]
        #// modulesCon = lista de ModuleItem
        #// ModuleItem = [ moduleCode, description, isActive, accessRightsInt ]
        #//
        #// Reglas:
        #//  - Solo modulos activos (INDWebModule.IsActive=Yes)
        #//  - Solo modulos con permiso (AccessRights != 0)
        #//  - Si una compania no tiene modulos resultantes, se omite
        #//  - Si defaultCompany inicial no tiene acceso, se usa la primera compania con acceso
        #//
        #// Nota: Tablas de contexto se asumen intercompany. Solo se usa changecompany para CompanyInfo.Name.
        #static container loginEntraContext(container _data)
        #{
        #    str 1000                    _entraOid;
        #    str 1000                    _appCode;
        #
        #    SysUserInfo                 sysUserInfo;
        #    INDWebApp                   webApp;
        #    INDWebModule                webModule;
        #    INDCiasPermitidas           ciasPerm;
        #    INDWebModuleAccessLevel     modAccess;
        #
        #    DataAreaId                  initialDefaultCompany;
        #    DataAreaId                  defaultCompany;
        #    DataAreaId                  firstAllowedCompany;
        #
        #    boolean                     initialDefaultAllowed = false;
        #
        #    boolean                     success = false;
        #    str                         message = "";
        #
        #    container                   header;
        #    container                   companiesCon, companyItem;
        #    container                   companiesConFixed;
        #    container                   modulesCon, moduleItem;
        #
        #    str                         companyName;
        #    int                         accessInt;
        #
        #    int                         i;
        #    DataAreaId                  tmpCompanyId;
        #    container                   tmpCompanyItem;
        #
        #    _entraOid = conPeek(_data, 1);
        #    _appCode  = conPeek(_data, 2);
        #
        #    if (!_entraOid || !_appCode)
        #        return [ INDCRMApiClass::buildActionResult(false, "EntraOid y AppCode son obligatorios."), conNull() ];
        #
        #    // 1) Resolver usuario AX por OID
        #    select firstonly sysUserInfo
        #        where sysUserInfo.ENTRAOID == _entraOid;
        #
        #    if (!sysUserInfo.Id)
