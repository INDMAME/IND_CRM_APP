			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  var json = pm.response.json();",
									"  var data = json.data || json.Data;",
									"  if (data && data.token) {",
									"    pm.collectionVariables.set('tokenId', data.token);",
									"  }",
									"} catch (e) {}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
						"raw": "{\n  \"Username\": \"{{USER_DEFAULT}}\",\n  \"Password\": \"{{USER_PASS_DEFAULT}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tokenId}}"
							}
						],
						"url": "{{baseUrl}}/api/auth/refresh"
					},
					"response": []
				},
				{
					"name": "Entra Context",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  var json = pm.response.json();",
									"  var items = json.items || json.Items;",
									"  if (!items || !items.length) return;",
									"  var first = items[0];",
									"  var header = first.Header || first.header || {};",
									"  var defaultCompany = header.DefaultCompany || header.defaultCompany;",
									"  if (defaultCompany) {",
									"    pm.collectionVariables.set('companyId', defaultCompany);",
									"    return;",
									"  }",
									"  var companies = first.Companies || first.companies || [];",
									"  if (companies.length > 0) {",
									"    var selected = companies.find(function(c){ return c.IsDefault || c.isDefault; }) || companies[0];",
									"    var companyId = selected.CompanyId || selected.companyId;",
									"    if (companyId) {",
									"      pm.collectionVariables.set('companyId', companyId);",
									"    }",
									"  }",
									"} catch (e) {}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tokenId}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"entraOid\": \"8faedaf3-b8d5-4629-9506-983d076279ba\",\n  \"appCode\": \"CRM\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/entra/context"
					},
					"response": []
				}
			]
