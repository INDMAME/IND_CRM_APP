{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Kestrel, HTTPS, Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-full",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/IND_CRM_APP.csproj",
        "--launch-profile",
        "vscode-https"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Chrome (UI local HTTPS 5001)",
      "type": "chrome",
      "request": "launch",
      "url": "https://localhost:5001",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Backend + Chrome (local)",
      "configurations": [
        "Backend (Kestrel, HTTPS, Debug)",
        "Chrome (UI local HTTPS 5001)"
      ]
    }
  ]
}
