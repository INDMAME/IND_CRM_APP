{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Kestrel, HTTPS, Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-with-kill",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/IND_CRM_APP.csproj",
        "--launch-profile",
        "vscode-https"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend + Chrome (local)",
      "configurations": [
        "Backend (Kestrel, HTTPS, Debug)",
        "Abrir Chrome (UI local HTTPS 7702)"
      ]
    }
  ]
}
